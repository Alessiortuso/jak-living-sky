{
  "anims": [
    {
      "t": 0.2,
      "actor": "v4-fisherman",
      "anim": "fisher-introduction",
      "loop": false,
      "speed": 1.0
    }
  ],
  "hold_jak": true,
  "length": 53.290000915527344,
  "letterbox": false,
  "lines": [
    {
      "file": "voice/fisher-ask.mp3",
      "len": 22.28499984741211,
      "speaker": "PESCATORE",
      "subs": [
        {
          "t": 0.0,
          "text": "EHI, RAGAZZI! CI SIETE ANCHE VOI! HO CAPTATO UN SEGNALE DAL TELETRASPORTATORE E SONO VENUTO A VEDERE."
        },
        {
          "t": 6.300000190734863,
          "text": "HO TROVATO IL VILLAGGIO VUOTO: DOPO UN BLACKOUT LA GENTE È SCAPPATA."
        },
        {
          "t": 10.479999542236328,
          "text": "PROBABILMENTE CON QUEL POCO DI ENERGIA RIMASTA, QUALCUNO SI È PERMESSO DI ATTIVARE IL TELETRASPORTATORE NELLA CAPANNA DEL SAGGIO..."
        },
        {
          "t": 17.350000381469727,
          "text": "...SPERANDO CHE ARRIVASSE QUALCUNO A SISTEMARE LE COSE. E A QUANTO PARE, ECCOVI QUI!"
        }
      ],
      "t": 0.20000000298023224,
      "volume": 200
    },
    {
      "file": "voice/fisher-ask2.mp3",
      "len": 29.808000564575195,
      "speaker": "PESCATORE",
      "subs": [
        {
          "t": 0.0,
          "text": "PER RIDARE L'ENERGIA AL VILLAGGIO BISOGNA SCENDERE NELLE CAVERNE ABBANDONATE."
        },
        {
          "t": 4.650000095367432,
          "text": "MA A ME PREOCCUPANO DI PIÙ I FIUMI: NASCONO PROPRIO DA QUELLE CAVERNE,"
        },
        {
          "t": 9.6899995803833,
          "text": "E DA QUALCHE GIORNO L'ACQUA È TORBIDA, VIOLA, E I MIEI PESCI SONO TUTTI INTOSSICATI..."
        },
        {
          "t": 15.300000190734863,
          "text": "È ECO OSCURO, NE SONO CERTO!"
        },
        {
          "t": 17.65999984741211,
          "text": "CI ANDREI IO A VEDERE, MA QUELLE CAVERNE PULLULANO DI LURKER!"
        },
        {
          "t": 21.760000228881836,
          "text": "GIÀ CHE SCENDI LAGGIÙ, SCOPRI DA DOVE ARRIVA QUELL'ECO OSCURO!"
        },
        {
          "t": 25.420000076293945,
          "text": "SE RIUSCIRETE NELL'IMPRESA VI RICOMPENSERÒ SICURAMENTE CON UNA BATTERIA..."
        }
      ],
      "t": 23.09000015258789,
      "volume": 200
    }
  ],
