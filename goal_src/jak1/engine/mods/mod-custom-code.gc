;;-*-Lisp-*-
(in-package goal)

;; name: mod-custom-code.gc
;; name in dgo: mod-custom-code
;; dgos: TODO

;;;;;;;;;;;;;;;;;;;;;;;;;;
;; What is this file for.
;;;;;;;;;;;;;;;;;;;;;;;;;;

#|
 This file contains function defenitions that are pre placed in the mod base,
    so if you place custom code inside of these functions, it will exectue based on
    the name of the function, for example, if you place (set! (-> *game-info* fuel) (+ (-> *game-info* fuel) 1))
    to the function named runs-on-orb-pickup, then jaks powercell count will increase each time you collect
    an orb
|#

;;;;;;;;;;;;;;;;;;;;;;;;;;
;; Begin function defintions.
;;;;;;;;;;;;;;;;;;;;;;;;;;

(defun runs-every-frame ()
  ;;(increase-power-cell-by-one) This is a call to increase-power-cell-by-one defined in mod-common-functions.gc
  (if *show-input-display* (input-display-on) (input-display-off))
  ;; ensure orb-placer is spawned/killed as requested, debug menu is updated
  (when *debug-segment*
    (orb-placer-maintenance))
  (none))

(defun runs-on-orb-pickup ((parent process-tree))
  (let* ((from-cache? (and parent (type-type? (-> parent type) orb-cache-top))))
    ;; Code here runs on ANY orb pickup
    (when from-cache?
      ;; Code here runs only if the orb was from an orb cache
      )
    (when (not from-cache?)
      ;; Code here runs only if the orb was NOT from an orb cache
      ))
  (none))

(defun runs-on-fly-pickup ()
  ;; Code here runs on any scout fly pickup
  (none))

(defun runs-on-cell-pickup ((cell-event symbol))
  (case cell-event
    (('pickup)
     ;; Code here runs as soon as you pickup a powercell
     )
    (('cutscene-end)
     ;; Code here runs at the end of any powercell cutscene
     ))
  (none))

(defun runs-on-eco-pickup ((eco-type pickup-type) (parent process-tree))
  (let* ((from-vent? (and parent (type-type? (-> parent type) vent))))
    ;; Code here runs as soon as you pickup ANY eco
    (case eco-type
      (((pickup-type eco-yellow))
       ;; Code here runs as soon as you pickup yellow eco
       )
      (((pickup-type eco-red))
       ;; Code here runs as soon as you pickup red eco
       )
      (((pickup-type eco-blue))
       ;; Code here runs as soon as you pickup blue eco
       )
      (((pickup-type eco-pill))
       ;; Code here runs as soon as you pickup small green eco
       )
      (((pickup-type eco-green))
       ;; Code here runs as soon as you pickup big green eco
       ))
    (when from-vent?
      ;; Code here runs only if the eco was picked up from a vent
      ))
  (none))

(defun runs-on-jak-spawn ()
  ;; Code here runs every time jak spawns (loading a file new game or death)
  ;;uncomment this to use custom music for custom levels - the function is in mod-common-functions.gc
  (process-spawn-function process music-manager-proc)
  (none))

(defun runs-on-checkpt ()
  ;; Code here runs every time jak spawns (loading a file new game or death)
  ;;uncomment this to use custom music for custom levels - the function is in mod-common-functions.gc
  (process-spawn-function process music-manager-proc)
  (none))

(defun runs-on-jak-death ((death-event symbol))
  (case death-event
    (('dying)
     ;; Code here runs immediately every time jak dies, before any death animation or death cutscene
     )
    (('blackout)
     ;; Code here runs after jak dies (and any death cutscene finishes), during the blackout before he spawns
     ))
  (none))

;;;;;;;;;;;;;;;;;;;;;;;;;;
;; deprecated function defintions.
;;;;;;;;;;;;;;;;;;;;;;;;;;

#| these are no longer recommended/supported however we include them anyways to not break anyones mods. |#

;; Jak Living Sky: Keira's radio about Brume Village, as the game's own radio calls: the floating radio
;; by Jak her voice comes from, her words as a subtitle; while she speaks of the signal the camera turns to
;; Rock Village's warp gate. Then Daxter, jealous. (custom_assets/jak1/audio/voice/*-brume.mp3)
;; where Rock Village's warp gate is: by the place its warp leaves Jak (the gate itself is only a process
;; once Jak is in the hut), 2 m up
(defun brume-warp-gate-pos ((out vector))
  (let ((cp (get-continue-by-name *game-info* "village2-warp")))
    (when cp
      (set! (-> out quad) (-> cp trans quad))
      (+! (-> out y) (meters 2))
      out)))

(defun brume-radio-subtitle ((speaker string) (id int))
  (when (and (-> *pc-settings* hinttitles?) (= *master-mode* 'game) (not *progress-process*))
    (let ((font (new 'stack 'font-context *font-default-matrix* 0 0 0.0 (font-color default) (font-flags shadow kerning))))
      (set! (-> font flags) (font-flags shadow kerning middle large))
      (hide-bottom-hud)
      (set! (-> font origin x) (* (- 1.0 (-> *SUBTITLE-bank* width)) 256))
      (set! (-> font origin y) (* (-> *SUBTITLE-bank* hint-height) 224))
      (set-width! font (the int (* (-> *SUBTITLE-bank* width) 512)))
      (set-height! font (the int (* (-> *SUBTITLE-bank* lines) 11)))
      (set-scale! font (* (-> *SUBTITLE-bank* scale) (enhanced-subtitle-size)))
      (print-game-subtitle (string-format "~3L~S:~0L ~S" speaker (lookup-text! *common-text* (the-as text-id id) #f))
                           font #f 128 22)))
  (none))

;; kept off the radio's stack (a spawned process's stack is saved in 256 bytes when it suspends)
(define *brume-cam-gate* (new 'global 'vector))
(define *brume-cam-pos* (new 'global 'vector))
(define *brume-cam-dir* (new 'global 'vector))

(defun brume-radio-play ()
  (process-spawn-function
    process
    (lambda :behavior process ()
      (voicebox-spawn self (target-pos 0))
      (play-sound-file "voice/keira-brume.mp3" 100)
      (let ((start (current-time))
            (gate (brume-warp-gate-pos *brume-cam-gate*))
            (looking #f)
            (pos *brume-cam-pos*))
        ;; Keira: 11 s; from the 5th, where she speaks of the signal, the camera holds still and looks at
        ;; the warp gate
        (while (not (time-elapsed? start (seconds 11.2)))
          (when (and gate (time-elapsed? start (seconds 5)) (> (-> *camera* num-slaves) 0))
            ;; closer: from where the camera is, toward the gate, until 8 m from it; Jak held still meanwhile
            (when (not looking)
              (set! looking #t)
              (let ((from (-> *camera* slave 0 0 trans)))
                (vector-lerp! pos gate from (fmin 1.0 (/ (meters 8) (vector-vector-distance gate from))))
              (send-event *target* 'change-mode 'grab)
              (send-event *camera* 'change-state cam-fixed 0))
            (dotimes (i (-> *camera* num-slaves))
              (let ((cam (-> *camera* slave i 0))
                    (dir *brume-cam-dir*))
                (set! (-> cam saved-pt quad) (-> pos quad))
                (set! (-> cam trans quad) (-> pos quad))
                (vector-! dir gate pos)
                (vector-normalize! dir 1.0)
                (forward-down->inv-matrix (-> cam tracking inv-mat) dir (-> *camera* local-down)))))
          (brume-radio-subtitle "KEIRA" #x4649)
          (suspend))
        (when looking
          (send-event *camera* 'change-state *camera-base-mode* 0)
          (send-event *target* 'end-mode))
        ;; Daxter: 7 s
        (play-sound-file "voice/daxter-brume.mp3" 200)
        (set! start (current-time))
        (while (not (time-elapsed? start (seconds 7.4)))
          (brume-radio-subtitle "DAXTER" #x464a)
          (suspend)))
      (none))
    :to *entity-pool*)
  (none))

;; Jak Living Sky: near the levitator without the cells, once Keira has said it takes 60: her line
;; with 60, not the game's with 45 (custom_assets/jak1/audio/voice/keira-levitator-60.mp3). Not again
;; for 30 s
(define *brume-lev-hint-last* -100000)

(defun brume-levitator-hint ()
  (let ((now (the int (/ (the float (current-time)) 300.0))))
    (when (or (< now *brume-lev-hint-last*) (>= (- now *brume-lev-hint-last*) 30))
      (set! *brume-lev-hint-last* now)
      (process-spawn-function
        process
        (lambda :behavior process ()
          (voicebox-spawn self (target-pos 0))
          (play-sound-file "voice/keira-levitator-60.mp3" 100)
          (let ((start (current-time)))
            (while (not (time-elapsed? start (seconds 4.5)))
              (brume-radio-subtitle "KEIRA" #x464b)
              (suspend)))
          (none))
        :to *entity-pool*)))
  (none))
