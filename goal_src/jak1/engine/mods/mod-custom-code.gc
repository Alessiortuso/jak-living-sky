#| these are no longer recommended/supported however we include them anyways to not break anyones mods. |#

;; Jak Living Sky: Keira's radio about Brume Village, as the game's own radio calls: the floating radio
;; by Jak her voice comes from, her words as a subtitle; while she speaks of the signal the camera turns to
;; Rock Village's warp gate. Then Daxter, jealous. (custom_assets/jak1/audio/voice/*-brume.mp3)
;; where Rock Village's warp gate is: by the place its warp leaves Jak (the gate itself is only a process
;; once Jak is in the hut), 2 m up
(defun brume-warp-gate-pos ((out vector))
  (let ((cp (get-continue-by-name *game-info* "village2-warp")))
    (when cp
      (set! (-> out quad) (-> cp trans quad))
      (+! (-> out y) (meters 2))
      out)))

(defun brume-radio-subtitle ((speaker string) (id int))
  (when (and (-> *pc-settings* hinttitles?) (= *master-mode* 'game) (not *progress-process*))
    (let ((font (new 'stack 'font-context *font-default-matrix* 0 0 0.0 (font-color default) (font-flags shadow kerning))))
      (set! (-> font flags) (font-flags shadow kerning middle large))
      (hide-bottom-hud)
      (set! (-> font origin x) (* (- 1.0 (-> *SUBTITLE-bank* width)) 256))
      (set! (-> font origin y) (* (-> *SUBTITLE-bank* hint-height) 224))
      (set-width! font (the int (* (-> *SUBTITLE-bank* width) 512)))
      (set-height! font (the int (* (-> *SUBTITLE-bank* lines) 11)))
      (set-scale! font (* (-> *SUBTITLE-bank* scale) (enhanced-subtitle-size)))
      (print-game-subtitle (string-format "~3L~S:~0L ~S" speaker (lookup-text! *common-text* (the-as text-id id) #f))
                           font #f 128 22)))
  (none))

;; ---------------------------------------------------------------------------------------------------------
;; Jak Living Sky: the scenes made in the game (the Enhanced menu's Cutscenes; game/graphics/enhanced_cutscene.cpp).
;; Every frame: what's going on, from there. Playing: its camera, black bars, Jak held, the HUD away, its subtitles,
;; triangle skips it. Editing: a free camera flown with the pad, told back to the editor (its shots are taken from
;; it):
;;   left stick: moves freely (forward where it looks, up and down with it), sideways
;;   L1 held: the left stick moves it only across the view: left, right, up, down
;;   R1 held: it holds on to the point it's looking at: the left stick takes it fast towards it or away, the right
;;            stick takes it round it, looking at it
;;   right stick: looks round. Square: slow, circle: fast
(define-extern set-letterbox-frames (function time-frame none))

(define *cs-out* (new 'static 'array float 12))
(define *cs-speaker* (new 'global 'string 64 (the-as string #f)))
(define *cs-text* (new 'global 'string 512 (the-as string #f)))
(define *cs-mode* 0)
(define *cs-held* #f)
(define *cs-pos* (new 'static 'vector))
(define *cs-look* (new 'static 'vector))
(define *cs-pivot* (new 'static 'vector))
(define *cs-yaw* 0.0)
(define *cs-pitch* 0.0)

(defun cutscene-on? ()
  (nonzero? *cs-mode*))

(defun cutscene-subtitle ((speaker string) (text string))
  (when (and (-> *pc-settings* hinttitles?) (not *progress-process*))
    (let ((font (new 'stack 'font-context *font-default-matrix* 0 0 0.0 (font-color default) (font-flags shadow kerning))))
      (set! (-> font flags) (font-flags shadow kerning middle large))
      (set! (-> font origin x) (* (- 1.0 (-> *SUBTITLE-bank* width)) 256))
      (set! (-> font origin y) (* (-> *SUBTITLE-bank* hint-height) 224))
      (set-width! font (the int (* (-> *SUBTITLE-bank* width) 512)))
      (set-height! font (the int (* (-> *SUBTITLE-bank* lines) 11)))
      (set-scale! font (* (-> *SUBTITLE-bank* scale) (enhanced-subtitle-size)))
      (if (nonzero? (length speaker))
        (print-game-subtitle (string-format "~3L~S:~0L ~S" speaker text) font #f 128 22)
        (print-game-subtitle text font #f 128 22))))
  (none))

;; the free camera's angles from where it is and what it looks at
(defun cutscene-aim-from-look ()
  (let ((d (new 'stack-no-clear 'vector)))
    (vector-! d *cs-look* *cs-pos*)
    (set! *cs-yaw* (atan (-> d x) (-> d z)))
    (set! *cs-pitch* (atan (-> d y) (sqrtf (+ (* (-> d x) (-> d x)) (* (-> d z) (-> d z)))))))
  (none))

;; its forward from its angles
(defun cutscene-forward ((out vector))
  (let ((cp (cos *cs-pitch*)))
    (set-vector! out (* (sin *cs-yaw*) cp) (sin *cs-pitch*) (* (cos *cs-yaw*) cp) 1.0))
  out)

;; the first thing solid along a line from the camera (else as far as it reaches)
(defun cutscene-aim-point ((out vector))
  (let ((fwd (new 'stack-no-clear 'vector))
        (tri (new 'stack-no-clear 'collide-tri-result)))
    (cutscene-forward fwd)
    (vector-float*! fwd fwd (meters 150))
    (let ((u (fill-and-probe-using-line-sphere *collide-cache* *cs-pos* fwd (meters 0.2)
                                               (collide-kind background cak-3 wall-object ground-object cak-14)
                                               (the-as process #f) tri (new 'static 'pat-surface :nocamera #x1))))
      (vector+float*! out *cs-pos* fwd (if (>= u 0.0) u 0.1))))
  out)

(defun cutscene-stick ((v int))
  "a stick's axis, -1 to 1, a little dead in the middle"
  (let ((f (/ (- (the float v) 128.0) 127.0)))
    (if (< (fabs f) 0.15) 0.0 f)))

(defun cutscene-free-camera ()
  (let* ((pad (-> *cpad-list* cpads 0))
         (lx (cutscene-stick (the int (-> pad leftx))))
         (ly (- (cutscene-stick (the int (-> pad lefty)))))
         (rx (cutscene-stick (the int (-> pad rightx))))
         (ry (- (cutscene-stick (the int (-> pad righty)))))
         (dt (seconds-per-frame))
         (speed (* (meters 8) dt (cond
                                   ((cpad-hold? 0 square) 0.25)
                                   ((cpad-hold? 0 circle) 3.0)
                                   (else 1.0))))
         (fwd (new 'stack-no-clear 'vector))
         (right (new 'stack-no-clear 'vector)))
    (cutscene-forward fwd)
    ;; the view's right (the game's x grows to the left of a camera looking down +z)
    (set-vector! right (- (cos *cs-yaw*)) 0.0 (sin *cs-yaw*) 1.0)
    (cond
      ((cpad-hold? 0 r1)
       ;; held on to the point aimed at (taken when R1 went down)
       (if (cpad-pressed? 0 r1) (cutscene-aim-point *cs-pivot*))
       (let ((to (new 'stack-no-clear 'vector)))
         (vector-! to *cs-pivot* *cs-pos*)
         (let ((dist (vector-length to)))
           ;; towards it or away, fast (never through it)
           (set! dist (fmax (meters 1) (- dist (* ly speed 4.0))))
           ;; round it
           (set! *cs-yaw* (- *cs-yaw* (* rx 12000.0 dt)))
           (set! *cs-pitch* (fmax -15000.0 (fmin 15000.0 (+ *cs-pitch* (* ry 9000.0 dt)))))
           (cutscene-forward fwd)
           (vector+float*! *cs-pos* *cs-pivot* fwd (- dist)))))
      (else
       ;; looking round
       (set! *cs-yaw* (- *cs-yaw* (* rx 12000.0 dt)))
       (set! *cs-pitch* (fmax -15000.0 (fmin 15000.0 (+ *cs-pitch* (* ry 9000.0 dt)))))
       (cutscene-forward fwd)
       (cond
         ((cpad-hold? 0 l1)
          ;; across the view only: left, right, up, down
          (vector+float*! *cs-pos* *cs-pos* right (* lx speed))
          (+! (-> *cs-pos* y) (* ly speed)))
         (else
          ;; freely: forward where it looks, sideways
          (vector+float*! *cs-pos* *cs-pos* fwd (* ly speed))
          (vector+float*! *cs-pos* *cs-pos* right (* lx speed))))))
    (vector+float*! *cs-look* *cs-pos* fwd (meters 10)))
  (none))

(defun cutscene-camera-apply ()
  (let ((dir (new 'stack-no-clear 'vector)))
    (vector-! dir *cs-look* *cs-pos*)
    (vector-normalize! dir 1.0)
    (dotimes (i (-> *camera* num-slaves))
      (let ((cam (-> *camera* slave i 0)))
        (set! (-> cam saved-pt quad) (-> *cs-pos* quad))
        (set! (-> cam trans quad) (-> *cs-pos* quad))
        (forward-down->inv-matrix (-> cam tracking inv-mat) dir (-> *camera* local-down)))))
  (none))

;; Jak Living Sky: the characters of a scene played as puppets: each one's animation from the scene (its name in
;; the character's art group, how far into it), forced just before its joints are worked out (ja-post's hook),
;; whatever its own code does; given back its own when the scene lets it go. Daxter follows Jak by himself
(define *cs-pup-name* (new 'global 'string 64 (the-as string #f)))
(define *cs-pup-anim* (new 'global 'string 64 (the-as string #f)))
(define *cs-pup-out* (new 'static 'array float 4))
(define *cs-pup-used* (new 'static 'array int32 6))
(define *cs-pup-seen* (new 'static 'array int32 6))
(define *cs-pup-proc* (new 'static 'array handle 6))
(define *cs-pup-art* (new 'static 'array uint32 6))
(define *cs-pup-saved* (new 'static 'array uint32 6))
(define *cs-pup-frame* (new 'static 'array float 6))
(define *cs-pup-count* 0)

(defun cutscene-puppet-proc ((i int))
  "the slot's character (only for a slot in use)"
  (the-as process-drawable (handle->process (-> *cs-pup-proc* i))))

(defun cutscene-puppet-slot ((pd process-drawable))
  "its slot, or a new one (its own animation kept), -1 if all are taken"
  (let ((found -1))
    (dotimes (i 6)
      (if (and (< found 0) (nonzero? (-> *cs-pup-used* i)) (= (cutscene-puppet-proc i) pd)) (set! found i)))
    (when (< found 0)
      (dotimes (i 6)
        (when (and (< found 0) (zero? (-> *cs-pup-used* i)))
          (set! found i)
          (set! (-> *cs-pup-used* i) 1)
          (set! (-> *cs-pup-proc* i) (process->handle pd))
          (set! (-> *cs-pup-saved* i) (the-as uint (-> pd skel root-channel 0 frame-group))))))
    found))

(defun cutscene-puppet-hook ((pd process-drawable))
  (when (nonzero? *cs-pup-count*)
    (dotimes (i 6)
      (when (and (nonzero? (-> *cs-pup-used* i)) (nonzero? (-> *cs-pup-seen* i)) (= (cutscene-puppet-proc i) pd))
        (let ((sk (-> pd skel)))
          (set! (-> sk active-channels) 1)
          (set! (-> sk root-channel) (-> sk channel))
          (set! (-> sk blend-index) -1)
          (let ((ch (-> sk root-channel 0)))
            (set! (-> ch command) 'push)
            (set! (-> ch group-sub-index) 0)
            (set! (-> ch group-size) 1)
            (set! (-> ch frame-interp) 0.0)
            (set! (-> ch frame-group) (the-as art-joint-anim (-> *cs-pup-art* i)))
            (set! (-> ch frame-num) (-> *cs-pup-frame* i))
            (set! (-> ch param 0) (-> *cs-pup-frame* i))
            (set! (-> ch num-func) num-func-identity)
            (set! (-> ch eval-time) (the-as uint (current-time))))))))
  (none))

(set! *ja-post-hook* cutscene-puppet-hook)

(defun cutscene-puppet-find ((name string))
  "a character by the name the editor lists it with"
  (let ((proc (if (string= name "jak") *target* (process-by-name name *active-pool*))))
    (if (and proc
             (type-type? (-> proc type) process-drawable)
             (nonzero? (-> (the-as process-drawable proc) skel))
             (nonzero? (-> (the-as process-drawable proc) draw)))
      (the-as process-drawable proc)
      (the-as process-drawable #f))))

(defun cutscene-puppets-update ((on symbol))
  (dotimes (i 6) (set! (-> *cs-pup-seen* i) 0))
  (when on
    (let ((i 0))
      (while (and (< i 8) (pc-cutscene-puppet i *cs-pup-name* *cs-pup-anim* *cs-pup-out*))
        (let ((pd (cutscene-puppet-find *cs-pup-name*)))
          (pc-cutscene-puppet-status i 0)
          (when pd
            (let ((art (the-as art-joint-anim (lookup-art (-> pd draw art-group) *cs-pup-anim* art-joint-anim))))
              (pc-cutscene-puppet-status i (if art 2 1))
              (when art
                (let ((slot (cutscene-puppet-slot pd)))
                  (when (>= slot 0)
                    (set! (-> *cs-pup-art* slot) (the-as uint art))
                    ;; its frame: seconds at 60 a second times its speed; round again, or held on its last
                    (let ((last (the float (+ -1 (-> art data 0 length))))
                          (f (* (-> *cs-pup-out* 0) 60.0 (-> art speed))))
                      (set! (-> *cs-pup-frame* slot)
                            (cond
                              ((<= last 0.0) 0.0)
                              ((!= (-> *cs-pup-out* 1) 0.0) (- f (* (the float (the int (/ f last))) last)))
                              (else (fmin f last)))))
                    (set! (-> *cs-pup-seen* slot) 1)))))))
        (+! i 1))))
  ;; the ones let go: their own animation back
  (set! *cs-pup-count* 0)
  (dotimes (i 6)
    (when (nonzero? (-> *cs-pup-used* i))
      (cond
        ((nonzero? (-> *cs-pup-seen* i)) (+! *cs-pup-count* 1))
        (else
         (let ((pd (cutscene-puppet-proc i)))
           (when (and pd (nonzero? (-> pd skel)) (!= pd *target*))
             (let ((ch (-> pd skel root-channel 0)))
               (set! (-> ch frame-group) (the-as art-joint-anim (-> *cs-pup-saved* i)))
               (set! (-> ch frame-num) 0.0)
               (set! (-> ch param 0) 0.0)
               (set! (-> ch num-func) num-func-identity))))
         (set! (-> *cs-pup-used* i) 0)))))
  (none))

;; the characters near the free camera, and their animations, for the editor's list
(defun cutscene-scan-actors ()
  (pc-cutscene-actors-begin)
  (iterate-process-tree
    *active-pool*
    (lambda ((p process-drawable))
      (when (and (type-type? (-> p type) process-drawable)
                 (not (type-type? (-> p type) sidekick))
                 (nonzero? (-> p skel))
                 (nonzero? (-> p draw))
                 (nonzero? (-> p root))
                 (< (vector-vector-distance (-> p root trans) *cs-pos*) (meters 40)))
        (let ((ag (-> p draw art-group))
              (nm (if (= p *target*) "jak" (the-as string (-> p name)))))
          (when (and ag (nonzero? ag) nm (= (-> nm type) string))
            (dotimes (i (-> ag length))
              (let ((a (-> ag data i)))
                (if (and a (nonzero? a) (type-type? (-> a type) art-joint-anim)) (pc-cutscene-actor nm (-> a name))))))))
      (none))
    *null-kernel-context*)
  (none))

(defun cutscene-update ()
  (when (and *target* *camera*)
    (let ((mode (pc-cutscene-poll *cs-out* *cs-speaker* *cs-text* 512)))
      (cutscene-puppets-update (nonzero? mode))
      (if (and (= mode 2) (!= (-> *cs-out* 10) 0.0)) (cutscene-scan-actors))
      (cond
        ((zero? mode)
         (when (nonzero? *cs-mode*)
           (send-event *camera* 'change-state *camera-base-mode* 0)
           (if *cs-held* (send-event *target* 'end-mode))
           (set! *cs-held* #f)))
        (else
         (when (zero? *cs-mode*)
           (send-event *camera* 'change-state cam-fixed 0)
           ;; (where the game's camera was, to start from)
           (set! (-> *cs-pos* quad) (-> (math-camera-pos) quad))
           (vector+float*! *cs-look* *cs-pos* (-> *math-camera* inv-camera-rot vector 2) (meters 10))
           (cutscene-aim-from-look))
         (when (and (not *cs-held*) (or (= mode 2) (!= (-> *cs-out* 8) 0.0)))
           (send-event *target* 'change-mode 'grab)
           (set! *cs-held* #t))
         (cond
           ((= mode 2)
            (when (!= (-> *cs-out* 6) 0.0)
              (set-vector! *cs-pos* (-> *cs-out* 0) (-> *cs-out* 1) (-> *cs-out* 2) 1.0)
              (set-vector! *cs-look* (-> *cs-out* 3) (-> *cs-out* 4) (-> *cs-out* 5) 1.0)
              (cutscene-aim-from-look))
            (cutscene-free-camera)
            (set! (-> *cs-out* 0) (-> *cs-pos* x))
            (set! (-> *cs-out* 1) (-> *cs-pos* y))
            (set! (-> *cs-out* 2) (-> *cs-pos* z))
            (set! (-> *cs-out* 3) (-> *cs-look* x))
            (set! (-> *cs-out* 4) (-> *cs-look* y))
            (set! (-> *cs-out* 5) (-> *cs-look* z))
            (pc-cutscene-report *cs-out*))
           ((!= (-> *cs-out* 9) 0.0)
            (set-vector! *cs-pos* (-> *cs-out* 0) (-> *cs-out* 1) (-> *cs-out* 2) 1.0)
            (set-vector! *cs-look* (-> *cs-out* 3) (-> *cs-out* 4) (-> *cs-out* 5) 1.0)))
         (cutscene-camera-apply)
         (if (!= (-> *cs-out* 7) 0.0) (set-letterbox-frames (seconds 0.1)))
         (hide-hud)
         (if (nonzero? (length *cs-text*)) (cutscene-subtitle *cs-speaker* *cs-text*))
         (when (and (= mode 1) (cpad-pressed? 0 triangle))
           (cpad-clear! 0 triangle)
           (pc-cutscene-stop))))
      (set! *cs-mode* mode)))
  (none))

;; Jak Living Sky: lines said by Daxter, the fisherman..., one after the other (never over each other). Timed
;; by the computer's own clock (300 ticks a second, as time-frames): the game's clocks step by whole frames and
;; drift from it below 60 fps, the subtitles running ahead of the voice and the next line over the last. Until
;; when someone's talking:
(define *daxter-talk-until* (the-as time-frame 0))

;; (the EE timer, 300,000,000 a second, wraps at 32 bits, every 14 s: its steps are added up instead, called every
;; frame (soul-pile-update). Kept in an array: a global symbol holds 32 bits. 0: the timer last seen, 1: what's
;; left over under a tick, 2: the ticks)
(define *quest-clock* (new 'static 'array int64 3))

(defun quest-now ()
  "now, by the computer's clock, in time-frame ticks (300 a second)"
  (let* ((raw (logand (the-as int (__read-ee-timer)) #xffffffff))
         (step (logand (- raw (-> *quest-clock* 0)) #xffffffff)))
    (set! (-> *quest-clock* 0) raw)
    ;; (a step longer than 10 s: the first, or the game held up: not counted)
    (when (< step 3000000000)
      (+! (-> *quest-clock* 1) step)
      (let ((ticks (/ (-> *quest-clock* 1) 1000000)))
        (+! (-> *quest-clock* 2) ticks)
        (-! (-> *quest-clock* 1) (* ticks 1000000)))))
  (the-as time-frame (-> *quest-clock* 2)))

;; (the game decodes a whole mp3 before it plays it: the longer, the later it starts)
(defun quest-line-latency ((len time-frame))
  (the-as time-frame (+ (seconds 0.3) (/ (the int len) 64))))

;; (lines given up, all those queued: a scene skipped. Each line keeps the count it was queued under)
(define *quest-gen* 0)

(defun quest-lines-cancel ()
  (+! *quest-gen* 1)
  (set! *daxter-talk-until* (quest-now))
  (none))

;; a line someone says (file: custom_assets/jak1/audio/voice/..., parts: subtitle text id, ticks (300 a
;; second), text id, ticks...: each part for its own time), after any other still going: its turn fixed now, in
;; the order asked for. Returns when its voice will start (quest-now's time)
(defun quest-line2 ((speaker string) (file string) (parts (array int32)))
  (let ((total 0))
    (dotimes (i (/ (-> parts length) 2))
      (+! total (-> parts (+ (* 2 i) 1))))
    (let* ((start-at (max (quest-now) *daxter-talk-until*))
           (late (quest-line-latency (the-as time-frame total))))
      (set! *daxter-talk-until* (+ start-at late total (seconds 0.6)))
      (process-spawn-function
        process
        (lambda :behavior process ((speaker string) (file string) (parts (array int32)) (start-at time-frame)
                                   (late time-frame) (gen int))
          (while (< (quest-now) start-at)
            (if (!= gen *quest-gen*) (deactivate self))
            (suspend))
          (play-sound-file file 200)
          (let ((start (+ (quest-now) late))
                (total 0))
            (dotimes (i (/ (-> parts length) 2))
              (+! total (-> parts (+ (* 2 i) 1))))
            (while (< (quest-now) (+ start total))
              (when (!= gen *quest-gen*)
                (stop-sound-file file)
                (deactivate self))
              (let ((at (- (quest-now) start))
                    (k 0))
                (while (and (< (+ k 2) (-> parts length)) (>= at (-> parts (+ k 1))))
                  (set! at (- at (-> parts (+ k 1))))
                  (+! k 2))
                (if (>= at 0) (brume-radio-subtitle speaker (-> parts k))))
              (suspend)))
          (none))
        speaker file parts start-at late *quest-gen*
        :to *entity-pool*)
      (the-as time-frame (+ start-at late)))))

;; (one subtitle for all of it)
(defun quest-line ((speaker string) (file string) (text int) (len time-frame))
  (let ((parts (new 'global 'boxed-array int32 2)))
    (set! (-> parts 0) text)
    (set! (-> parts 1) (the int len))
    (quest-line2 speaker file parts))
  (none))

(defun daxter-dark-line ((file string) (text int) (len time-frame))
  (quest-line "DAXTER" file text len)
  (none))

;; the first time a corrupted enemy is near (nav-enemy.gc): "Jak, look at that one! Its eyes are purple..."
;; (custom_assets/jak1/audio/voice/daxter-dark-enemy.mp3, 5.7 s)
(defun daxter-dark-enemy-line ()
  (set! *daxter-dark-seen* 1.0)
  (daxter-dark-line "voice/daxter-dark-enemy.mp3" #x464e (seconds 5.9))
  (none))

;; the first time Jak takes in dark eco (collectables.gc): "Jak, stop! That's dark eco! You don't want to turn
;; into an ottsel too?" (daxter-dark-eco.mp3, 5.1 s)
(defun daxter-dark-eco-line ()
  (set! *daxter-dark-eco-seen* 1.0)
  (daxter-dark-line "voice/daxter-dark-eco.mp3" #x464f (seconds 5.3))
  (none))

;; the first time Jak turns into Dark Jak (target2.gc), once the turning's roar is over: "Jak? Are... are you
;; still in there? Give me a sign..." (daxter-dark-jak.mp3, 5.9 s)
(defun daxter-dark-jak-line ()
  (set! *daxter-dark-jak-seen* 1.0)
  (set! *daxter-talk-until* (max *daxter-talk-until* (+ (quest-now) (seconds 2))))
  (daxter-dark-line "voice/daxter-dark-jak.mp3" #x4650 (seconds 6.1))
  (none))

;; Jak turning back from Dark Jak (his time over, or another eco taken; not dying). The first time: "Maybe we'd
;; better not tell Samos what happened to you." (daxter-dark-jak-end.mp3, 3.9 s); the second: "Oh, so dark eco
;; gives you horns and superpowers, and me orange fur? That's not fair!" (daxter-dark-jak-end2.mp3, 6 s)
(defun dark-jak-end-line ()
  (when (and (< *daxter-dark-jak-end-seen* 2.0) *target*
             (not (logtest? (-> *target* state-flags) (state-flags dying))))
    (if (zero? *daxter-dark-jak-end-seen*)
      (daxter-dark-line "voice/daxter-dark-jak-end.mp3" #x4651 (seconds 4.1))
      (daxter-dark-line "voice/daxter-dark-jak-end2.mp3" #x4652 (seconds 6.2)))
    (set! *daxter-dark-jak-end-seen* (+ *daxter-dark-jak-end-seen* 1.0)))
  (none))

;; kept off the radio's stack (a spawned process's stack is saved in 256 bytes when it suspends)
(define *brume-cam-gate* (new 'global 'vector))
(define *brume-cam-pos* (new 'global 'vector))
(define *brume-cam-dir* (new 'global 'vector))

(defun brume-radio-play ()
  (process-spawn-function
    process
    (lambda :behavior process ()
      (voicebox-spawn self (target-pos 0))
      (play-sound-file "voice/keira-brume.mp3" 100)
      (let ((start (current-time))
            (gate (brume-warp-gate-pos *brume-cam-gate*))
            (looking #f)
            (pos *brume-cam-pos*))
        ;; Keira: 11 s; from the 5th, where she speaks of the signal, the camera holds still and looks at
        ;; the warp gate
        (while (not (time-elapsed? start (seconds 11.2)))
          (when (and gate (time-elapsed? start (seconds 5)) (> (-> *camera* num-slaves) 0))
            ;; closer: from where the camera is, toward the gate, until 8 m from it; Jak held still meanwhile
            (when (not looking)
              (set! looking #t)
              (let ((from (-> *camera* slave 0 0 trans)))
                (vector-lerp! pos gate from (fmin 1.0 (/ (meters 8) (vector-vector-distance gate from)))))
              (send-event *target* 'change-mode 'grab)
              (send-event *camera* 'change-state cam-fixed 0))
            (dotimes (i (-> *camera* num-slaves))
              (let ((cam (-> *camera* slave i 0))
                    (dir *brume-cam-dir*))
                (set! (-> cam saved-pt quad) (-> pos quad))
                (set! (-> cam trans quad) (-> pos quad))
                (vector-! dir gate pos)
                (vector-normalize! dir 1.0)
                (forward-down->inv-matrix (-> cam tracking inv-mat) dir (-> *camera* local-down)))))
          (brume-radio-subtitle "KEIRA" #x4649)
          (suspend))
        (when looking
          (send-event *camera* 'change-state *camera-base-mode* 0)
          (send-event *target* 'end-mode))
        ;; Daxter: 7 s
        (play-sound-file "voice/daxter-brume.mp3" 200)
        (set! start (current-time))
        (while (not (time-elapsed? start (seconds 7.4)))
          (brume-radio-subtitle "DAXTER" #x464a)
          (suspend)))
      (none))
    :to *entity-pool*)
  (none))

;; Jak Living Sky: near the levitator without the cells, once Keira has said it takes 60: her line
;; with 60, not the game's with 45 (custom_assets/jak1/audio/voice/keira-levitator-60.mp3). Not again
;; for 30 s
(define *brume-lev-hint-last* -100000)

(defun brume-levitator-hint ()
  (let ((now (the int (/ (the float (current-time)) 300.0))))
    (when (or (< now *brume-lev-hint-last*) (>= (- now *brume-lev-hint-last*) 30))
      (set! *brume-lev-hint-last* now)
      (process-spawn-function
        process
        (lambda :behavior process ()
          (voicebox-spawn self (target-pos 0))
          (play-sound-file "voice/keira-levitator-60.mp3" 100)
          (let ((start (current-time)))
            (while (not (time-elapsed? start (seconds 4.5)))
              (brume-radio-subtitle "KEIRA" #x464b)
              (suspend)))
          (none))
        :to *entity-pool*)))
  (none))
