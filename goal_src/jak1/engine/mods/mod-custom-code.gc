;;-*-Lisp-*-
(in-package goal)

;; name: mod-custom-code.gc
;; name in dgo: mod-custom-code
;; dgos: TODO

;;;;;;;;;;;;;;;;;;;;;;;;;;
;; What is this file for.
;;;;;;;;;;;;;;;;;;;;;;;;;;

#|
 This file contains function defenitions that are pre placed in the mod base,
    so if you place custom code inside of these functions, it will exectue based on
    the name of the function, for example, if you place (set! (-> *game-info* fuel) (+ (-> *game-info* fuel) 1))
    to the function named runs-on-orb-pickup, then jaks powercell count will increase each time you collect
    an orb
|#

;;;;;;;;;;;;;;;;;;;;;;;;;;
;; Begin function defintions.
;;;;;;;;;;;;;;;;;;;;;;;;;;

(defun runs-every-frame ()
  ;;(increase-power-cell-by-one) This is a call to increase-power-cell-by-one defined in mod-common-functions.gc
  (if *show-input-display* (input-display-on) (input-display-off))
  ;; ensure orb-placer is spawned/killed as requested, debug menu is updated
  (when *debug-segment*
    (orb-placer-maintenance))
  (none))

(defun runs-on-orb-pickup ((parent process-tree))
  (let* ((from-cache? (and parent (type-type? (-> parent type) orb-cache-top))))
    ;; Code here runs on ANY orb pickup
    (when from-cache?
      ;; Code here runs only if the orb was from an orb cache
      )
    (when (not from-cache?)
      ;; Code here runs only if the orb was NOT from an orb cache
      ))
  (none))

(defun runs-on-fly-pickup ()
  ;; Code here runs on any scout fly pickup
  (none))

(defun runs-on-cell-pickup ((cell-event symbol))
  (case cell-event
    (('pickup)
     ;; Code here runs as soon as you pickup a powercell
     )
    (('cutscene-end)
     ;; Code here runs at the end of any powercell cutscene
     ))
  (none))

(defun runs-on-eco-pickup ((eco-type pickup-type) (parent process-tree))
  (let* ((from-vent? (and parent (type-type? (-> parent type) vent))))
    ;; Code here runs as soon as you pickup ANY eco
    (case eco-type
      (((pickup-type eco-yellow))
       ;; Code here runs as soon as you pickup yellow eco
       )
      (((pickup-type eco-red))
       ;; Code here runs as soon as you pickup red eco
       )
      (((pickup-type eco-blue))
       ;; Code here runs as soon as you pickup blue eco
       )
      (((pickup-type eco-pill))
       ;; Code here runs as soon as you pickup small green eco
       )
      (((pickup-type eco-green))
       ;; Code here runs as soon as you pickup big green eco
       ))
    (when from-vent?
      ;; Code here runs only if the eco was picked up from a vent
      ))
  (none))

(defun runs-on-jak-spawn ()
  ;; Code here runs every time jak spawns (loading a file new game or death)
  ;;uncomment this to use custom music for custom levels - the function is in mod-common-functions.gc
  (process-spawn-function process music-manager-proc)
  (none))

(defun runs-on-checkpt ()
  ;; Code here runs every time jak spawns (loading a file new game or death)
  ;;uncomment this to use custom music for custom levels - the function is in mod-common-functions.gc
  (process-spawn-function process music-manager-proc)
  (none))

(defun runs-on-jak-death ((death-event symbol))
  (case death-event
    (('dying)
     ;; Code here runs immediately every time jak dies, before any death animation or death cutscene
     )
    (('blackout)
     ;; Code here runs after jak dies (and any death cutscene finishes), during the blackout before he spawns
     ))
  (none))

;;;;;;;;;;;;;;;;;;;;;;;;;;
;; deprecated function defintions.
;;;;;;;;;;;;;;;;;;;;;;;;;;

#| these are no longer recommended/supported however we include them anyways to not break anyones mods. |#

;; Jak Living Sky: Keira's radio about Brume Village, as the game's own radio calls: the floating radio
;; by Jak her voice comes from, her words as a subtitle; while she speaks of the signal the camera turns to
;; Rock Village's warp gate. Then Daxter, jealous. (custom_assets/jak1/audio/voice/*-brume.mp3)
;; where Rock Village's warp gate is: by the place its warp leaves Jak (the gate itself is only a process
;; once Jak is in the hut), 2 m up
(defun brume-warp-gate-pos ((out vector))
  (let ((cp (get-continue-by-name *game-info* "village2-warp")))
    (when cp
      (set! (-> out quad) (-> cp trans quad))
      (+! (-> out y) (meters 2))
      out)))

(defun brume-radio-subtitle ((speaker string) (id int))
  (when (and (-> *pc-settings* hinttitles?) (= *master-mode* 'game) (not *progress-process*))
    (let ((font (new 'stack 'font-context *font-default-matrix* 0 0 0.0 (font-color default) (font-flags shadow kerning))))
      (set! (-> font flags) (font-flags shadow kerning middle large))
      (hide-bottom-hud)
      (set! (-> font origin x) (* (- 1.0 (-> *SUBTITLE-bank* width)) 256))
      (set! (-> font origin y) (* (-> *SUBTITLE-bank* hint-height) 224))
      (set-width! font (the int (* (-> *SUBTITLE-bank* width) 512)))
      (set-height! font (the int (* (-> *SUBTITLE-bank* lines) 11)))
      (set-scale! font (* (-> *SUBTITLE-bank* scale) (enhanced-subtitle-size)))
      (print-game-subtitle (string-format "~3L~S:~0L ~S" speaker (lookup-text! *common-text* (the-as text-id id) #f))
                           font #f 128 22)))
  (none))

;; ---------------------------------------------------------------------------------------------------------
;; Jak Living Sky: the scenes made in the game (the Enhanced menu's Cutscenes; game/graphics/enhanced_cutscene.cpp).
;; Every frame: what's going on, from there. Playing: its camera, black bars, Jak held, the HUD away, its subtitles,
;; triangle skips it. Editing: a free camera flown with the pad, told back to the editor (its shots are taken from
;; it):
;;   left stick: moves freely (forward where it looks, up and down with it), sideways
;;   L1 held: the left stick moves it only across the view: left, right, up, down
;;   R1 held: it holds on to the point it's looking at: the left stick takes it fast towards it or away, the right
;;            stick takes it round it, looking at it
;;   right stick: looks round. Square: slow, circle: fast
(define-extern set-letterbox-frames (function time-frame none))

(define *cs-out* (new 'static 'array float 12))
(define *cs-speaker* (new 'global 'string 64 (the-as string #f)))
(define *cs-text* (new 'global 'string 512 (the-as string #f)))
(define *cs-mode* 0)
(define *cs-held* #f)
(define *cs-pos* (new 'static 'vector))
(define *cs-look* (new 'static 'vector))
(define *cs-pivot* (new 'static 'vector))
(define *cs-yaw* 0.0)
(define *cs-pitch* 0.0)

(defun cutscene-on? ()
  (nonzero? *cs-mode*))

(defun cutscene-subtitle ((speaker string) (text string))
  (when (and (-> *pc-settings* hinttitles?) (not *progress-process*))
    (let ((font (new 'stack 'font-context *font-default-matrix* 0 0 0.0 (font-color default) (font-flags shadow kerning))))
      (set! (-> font flags) (font-flags shadow kerning middle large))
      (set! (-> font origin x) (* (- 1.0 (-> *SUBTITLE-bank* width)) 256))
      (set! (-> font origin y) (* (-> *SUBTITLE-bank* hint-height) 224))
      (set-width! font (the int (* (-> *SUBTITLE-bank* width) 512)))
      (set-height! font (the int (* (-> *SUBTITLE-bank* lines) 11)))
      (set-scale! font (* (-> *SUBTITLE-bank* scale) (enhanced-subtitle-size)))
      (if (nonzero? (length speaker))
        (print-game-subtitle (string-format "~3L~S:~0L ~S" speaker text) font #f 128 22)
        (print-game-subtitle text font #f 128 22))))
  (none))

;; the free camera's angles from where it is and what it looks at
(defun cutscene-aim-from-look ()
  (let ((d (new 'stack-no-clear 'vector)))
    (vector-! d *cs-look* *cs-pos*)
    (set! *cs-yaw* (atan (-> d x) (-> d z)))
    (set! *cs-pitch* (atan (-> d y) (sqrtf (+ (* (-> d x) (-> d x)) (* (-> d z) (-> d z)))))))
  (none))

;; its forward from its angles
(defun cutscene-forward ((out vector))
  (let ((cp (cos *cs-pitch*)))
    (set-vector! out (* (sin *cs-yaw*) cp) (sin *cs-pitch*) (* (cos *cs-yaw*) cp) 1.0))
  out)

;; the first thing solid along a line from the camera (else as far as it reaches)
(defun cutscene-aim-point ((out vector))
  (let ((fwd (new 'stack-no-clear 'vector))
        (tri (new 'stack-no-clear 'collide-tri-result)))
    (cutscene-forward fwd)
    (vector-float*! fwd fwd (meters 150))
    (let ((u (fill-and-probe-using-line-sphere *collide-cache* *cs-pos* fwd (meters 0.2)
                                               (collide-kind background cak-3 wall-object ground-object cak-14)
                                               (the-as process #f) tri (new 'static 'pat-surface :nocamera #x1))))
      (vector+float*! out *cs-pos* fwd (if (>= u 0.0) u 0.1))))
  out)

(defun cutscene-stick ((v int))
  "a stick's axis, -1 to 1, a little dead in the middle"
  (let ((f (/ (- (the float v) 128.0) 127.0)))
    (if (< (fabs f) 0.15) 0.0 f)))

(define-extern cutscene-grab-update (function symbol))

(defun cutscene-free-camera ()
  (if (not (cutscene-grab-update))
  (let* ((pad (-> *cpad-list* cpads 0))
         (lx (cutscene-stick (the int (-> pad leftx))))
         (ly (- (cutscene-stick (the int (-> pad lefty)))))
         (rx (cutscene-stick (the int (-> pad rightx))))
         (ry (- (cutscene-stick (the int (-> pad righty)))))
         (dt (seconds-per-frame))
         (speed (* (meters 8) dt (cond
                                   ((cpad-hold? 0 square) 0.25)
                                   ((cpad-hold? 0 circle) 3.0)
                                   (else 1.0))))
         (fwd (new 'stack-no-clear 'vector))
         (right (new 'stack-no-clear 'vector)))
    (cutscene-forward fwd)
    ;; the view's right (the game's x grows to the left of a camera looking down +z)
    (set-vector! right (- (cos *cs-yaw*)) 0.0 (sin *cs-yaw*) 1.0)
    (cond
      ((cpad-hold? 0 r1)
       ;; held on to the point aimed at (taken when R1 went down)
       (if (cpad-pressed? 0 r1) (cutscene-aim-point *cs-pivot*))
       (let ((to (new 'stack-no-clear 'vector)))
         (vector-! to *cs-pivot* *cs-pos*)
         (let ((dist (vector-length to)))
           ;; towards it or away, fast (never through it)
           (set! dist (fmax (meters 1) (- dist (* ly speed 4.0))))
           ;; round it
           (set! *cs-yaw* (- *cs-yaw* (* rx 12000.0 dt)))
           (set! *cs-pitch* (fmax -15000.0 (fmin 15000.0 (+ *cs-pitch* (* ry 9000.0 dt)))))
           (cutscene-forward fwd)
           (vector+float*! *cs-pos* *cs-pivot* fwd (- dist)))))
      (else
       ;; looking round
       (set! *cs-yaw* (- *cs-yaw* (* rx 12000.0 dt)))
       (set! *cs-pitch* (fmax -15000.0 (fmin 15000.0 (+ *cs-pitch* (* ry 9000.0 dt)))))
       (cutscene-forward fwd)
       (cond
         ((cpad-hold? 0 l1)
          ;; across the view only: left, right, up, down
          (vector+float*! *cs-pos* *cs-pos* right (* lx speed))
          (+! (-> *cs-pos* y) (* ly speed)))
         (else
          ;; freely: forward where it looks, sideways
          (vector+float*! *cs-pos* *cs-pos* fwd (* ly speed))
          (vector+float*! *cs-pos* *cs-pos* right (* lx speed))))))
    (vector+float*! *cs-look* *cs-pos* fwd (meters 10))))
  (none))

(defun cutscene-camera-apply ()
  (let ((dir (new 'stack-no-clear 'vector)))
    (vector-! dir *cs-look* *cs-pos*)
    (vector-normalize! dir 1.0)
    (dotimes (i (-> *camera* num-slaves))
      (let ((cam (-> *camera* slave i 0)))
        (set! (-> cam saved-pt quad) (-> *cs-pos* quad))
        (set! (-> cam trans quad) (-> *cs-pos* quad))
        (forward-down->inv-matrix (-> cam tracking inv-mat) dir (-> *camera* local-down)))))
  (none))

;; Jak Living Sky: the characters of a scene played as puppets: each one's animation from the scene (its name in
;; the character's art group, how far into it), forced just before its joints are worked out (ja-post's hook),
;; whatever its own code does; given back its own when the scene lets it go. Daxter follows Jak by himself
(define *cs-pup-name* (new 'global 'string 64 (the-as string #f)))
(define *cs-pup-anim* (new 'global 'string 64 (the-as string #f)))
(define *cs-pup-out* (new 'static 'array float 4))
(define *cs-pup-used* (new 'static 'array int32 6))
(define *cs-pup-seen* (new 'static 'array int32 6))
(define *cs-pup-proc* (new 'static 'array handle 6))
(define *cs-pup-art* (new 'static 'array uint32 6))
(define *cs-pup-saved* (new 'static 'array uint32 6))
(define *cs-pup-frame* (new 'static 'array float 6))
(define *cs-pup-count* 0)
(define *cs-pup-blerc* (new 'static 'array int32 6))
;; (a character's place, for the editor's list: x y z, facing in degrees)
(define *cs-at* (new 'static 'array float 4))
;; (the log: each one's last state said, and whether its animation was put on it yet)
(define *cs-pup-said* (new 'static 'array int32 8))
(define *cs-pup-applied* (new 'static 'array int32 6))
(define *cs-pup-hook-calls* 0)

(define-extern cutscene-puppet-find (function string process-drawable))

(defun cutscene-puppet-say ((i int) (st int))
  (when (and (< i 8) (!= (-> *cs-pup-said* i) (+ st 1)))
    (set! (-> *cs-pup-said* i) (+ st 1))
    (format 0 "[cutscene] puppet ~D ~S ~S: ~S~%" i *cs-pup-name* *cs-pup-anim*
            (case st ((0) "character not found") ((1) "animation not found") ((2) "found") (else "let go")))
    (let ((pd (cutscene-puppet-find *cs-pup-name*)))
      (when pd
        (format 0 "[cutscene]   it is ~A, state ~A, post ~A; hook ~A~%" pd
                (if (-> pd state) (-> pd state name) 'none)
                (if (-> pd state) (-> pd state post) 'none)
                *ja-post-hook*))))
  (none))

(defun cutscene-puppet-proc ((i int))
  "the slot's character (only for a slot in use)"
  (the-as process-drawable (handle->process (-> *cs-pup-proc* i))))

(defun cutscene-puppet-slot ((pd process-drawable))
  "its slot, or a new one (its own animation kept), -1 if all are taken"
  (let ((found -1))
    (dotimes (i 6)
      (if (and (< found 0) (nonzero? (-> *cs-pup-used* i)) (= (cutscene-puppet-proc i) pd)) (set! found i)))
    (when (< found 0)
      (dotimes (i 6)
        (when (and (< found 0) (zero? (-> *cs-pup-used* i)))
          (set! found i)
          (set! (-> *cs-pup-used* i) 1)
          (set! (-> *cs-pup-proc* i) (process->handle pd))
          (set! (-> *cs-pup-saved* i) (the-as uint (-> pd skel root-channel 0 frame-group)))
          (set! (-> *cs-pup-blerc* i) (if (logtest? (-> pd skel status) (janim-status blerc)) 1 0)))))
    found))

(defun cutscene-puppet-apply ((i int) (pd process-drawable))
  "the slot's animation and frame on its character's first channel, alone"
  (when (zero? (-> *cs-pup-applied* i))
    (set! (-> *cs-pup-applied* i) 1)
    (format 0 "[cutscene] animation put on ~A (frame ~f)~%" pd (-> *cs-pup-frame* i)))
  ;; (its face's blend shapes too: the mouth, in the animations that have it)
  (logior! (-> pd skel status) (janim-status blerc))
  (let ((sk (-> pd skel)))
          (set! (-> sk active-channels) 1)
          (set! (-> sk root-channel) (-> sk channel))
          (set! (-> sk blend-index) -1)
          (let ((ch (-> sk root-channel 0)))
            (set! (-> ch command) 'push)
            (set! (-> ch group-sub-index) 0)
            (set! (-> ch group-size) 1)
            (set! (-> ch frame-interp) 0.0)
            (set! (-> ch frame-group) (the-as art-joint-anim (-> *cs-pup-art* i)))
            (set! (-> ch frame-num) (-> *cs-pup-frame* i))
            (set! (-> ch param 0) (-> *cs-pup-frame* i))
            (set! (-> ch num-func) num-func-identity)
            (set! (-> ch eval-time) (the-as uint (current-time)))))
  (none))

(define-extern cutscene-place-hook (function process-drawable none))

(defun cutscene-puppet-hook ((pd process-drawable))
  (when (< *cs-pup-hook-calls* 2)
    (+! *cs-pup-hook-calls* 1)
    (format 0 "[cutscene] ja-post hook called for ~A (~D puppets)~%" pd *cs-pup-count*))
  (when (nonzero? *cs-pup-count*)
    (dotimes (i 6)
      (when (and (nonzero? (-> *cs-pup-used* i)) (nonzero? (-> *cs-pup-seen* i)) (= (cutscene-puppet-proc i) pd))
        (cutscene-puppet-apply i pd))))
  (cutscene-place-hook pd)
  (none))

(set! *ja-post-hook* cutscene-puppet-hook)

(defun cutscene-puppet-find ((name string))
  "a character by the name the editor lists it with"
  (let ((proc (if (string= name "jak") *target* (process-by-name name *active-pool*))))
    (if (and proc
             (type-type? (-> proc type) process-drawable)
             (nonzero? (-> (the-as process-drawable proc) skel))
             (nonzero? (-> (the-as process-drawable proc) draw)))
      (the-as process-drawable proc)
      (the-as process-drawable #f))))

;; Jak Living Sky: the game's own cutscene animations (streamed from the disc a part at a time, the way the game
;; plays them: the part playing and the next one in the two spool buffers), for the scenes' characters: the
;; fisherman's, and Jak's in them (each part has both). By name, with how many parts
(define *cs-spools* (new 'static 'boxed-array :type string
                         "fisher-introduction" "fisher-resolution" "fisher-accept" "fisher-reject" "fisher-reminder-1"))
(define *cs-spool-parts* (new 'static 'boxed-array :type int32 9 4 6 2 1))
;; each slot's: its spool (+1, 0 none), the part playing, when that part began (ticks of 1/60 s from its key)
(define *cs-pup-spool* (new 'static 'array int32 6))
(define *cs-pup-part* (new 'static 'array int32 6))
(define *cs-pup-pstart* (new 'static 'array float 6))
(define *cs-spool-said* (new 'static 'array int32 128))

(defun cutscene-spool-index ((name string))
  (let ((found -1))
    (dotimes (i (-> *cs-spools* length))
      (if (and (< found 0) (string= name (-> *cs-spools* i))) (set! found i)))
    found))

(defun cutscene-spool-art ((name string) (part int) (pd process-drawable))
  "the character's animation in that part, if the part is in a spool buffer"
  (let ((found (the-as art-joint-anim #f)))
    (dotimes (b 2)
      (let ((buf (-> *art-control* buffer b)))
        (when (and (= (-> buf status) 'active)
                   (name= (-> buf load-file) name)
                   (= (-> buf load-file-part) part)
                   (-> buf art-group))
          (let ((ag (-> buf art-group)))
            (dotimes (i (-> ag length))
              (let ((a (-> ag data i)))
                (when (and (not found)
                           a
                           (nonzero? a)
                           (type-type? (-> a type) art-joint-anim)
                           (name= (-> (the-as art-joint-anim a) master-art-group-name) (-> pd draw art-group name)))
                  (set! found (the-as art-joint-anim a)))))))))
    found))

(defun cutscene-spool-frame ((slot int) (spool int) (pd process-drawable) (ticks float))
  "the part's animation for that time (its frame in *cs-pup-frame*), on to the next part as time goes; #f while
   the part is still loading"
  (when (or (!= (-> *cs-pup-spool* slot) (+ spool 1)) (< ticks (-> *cs-pup-pstart* slot)))
    ;; (a new one, or back before the part playing: from the first part again)
    (set! (-> *cs-pup-spool* slot) (+ spool 1))
    (set! (-> *cs-pup-part* slot) 0)
    (set! (-> *cs-pup-pstart* slot) 0.0))
  (let ((name (-> *cs-spools* spool))
        (parts (-> *cs-spool-parts* spool))
        (result (the-as art-joint-anim #f))
        (tries 0))
    (while (< tries 12)
      (+! tries 1)
      (let ((part (-> *cs-pup-part* slot)))
        (spool-push *art-control* name part pd -20.0)
        (if (< (+ part 1) parts) (spool-push *art-control* name (+ part 1) pd -10.0))
        (let ((a (cutscene-spool-art name part pd)))
          (cond
            ((not a) (set! tries 99))
            (else
             ;; (each part's length said once in the log: to time a scene to them)
             (when (and (< (+ (* spool 16) part) 128) (zero? (-> *cs-spool-said* (+ (* spool 16) part))))
               (set! (-> *cs-spool-said* (+ (* spool 16) part)) 1)
               (format 0 "[cutscene] spool ~S part ~D: ~D frames, speed ~f (~f s)~%" name part
                       (-> a data 0 length) (-> a speed)
                       (/ (the float (+ -1 (-> a data 0 length))) (* 60.0 (if (< 0.0 (-> a speed)) (-> a speed) 1.0)))))
             (let* ((spd (if (< 0.0 (-> a speed)) (-> a speed) 1.0))
                    (last (the float (+ -1 (-> a data 0 length))))
                    (local (* (- ticks (-> *cs-pup-pstart* slot)) spd)))
               (cond
                 ((and (< last local) (< (+ part 1) parts) (cutscene-spool-art name (+ part 1) pd))
                  ;; past this part, and the next is in: on to it
                  (+! (-> *cs-pup-pstart* slot) (/ last spd))
                  (+! (-> *cs-pup-part* slot) 1))
                 (else
                  (set! (-> *cs-pup-frame* slot) (fmax 0.0 (fmin local last)))
                  (set! result a)
                  (set! tries 99)))))))))
    result))

(defun cutscene-puppets-update ((on symbol))
  ;; (the hook put in from here: set when this file loaded, process-drawable.gc, loaded after, put it back to #f)
  (set! *ja-post-hook* cutscene-puppet-hook)
  (dotimes (i 6) (set! (-> *cs-pup-seen* i) 0))
  (when on
    (let ((i 0))
      (while (and (< i 8) (pc-cutscene-puppet i *cs-pup-name* *cs-pup-anim* *cs-pup-out*))
        (let ((pd (cutscene-puppet-find *cs-pup-name*)))
          (pc-cutscene-puppet-status i 0)
          (if (not pd) (cutscene-puppet-say i 0))
          (when (and pd (>= (cutscene-spool-index *cs-pup-anim*) 0))
            ;; one of the game's cutscenes: its part for this time (meanwhile, its own animation)
            (pc-cutscene-puppet-status i 2)
            (cutscene-puppet-say i 2)
            (let ((slot (cutscene-puppet-slot pd)))
              (when (>= slot 0)
                (let ((a (cutscene-spool-frame slot (cutscene-spool-index *cs-pup-anim*) pd
                                               (* (-> *cs-pup-out* 0) 60.0))))
                  (cond
                    (a (set! (-> *cs-pup-art* slot) (the-as uint a)))
                    (else
                     (set! (-> *cs-pup-art* slot) (-> *cs-pup-saved* slot))
                     (set! (-> *cs-pup-frame* slot) 0.0))))
                (when (nonzero? (-> *cs-pup-art* slot))
                  (set! (-> *cs-pup-seen* slot) 1)
                  (cutscene-puppet-apply slot pd)))))
          (when (and pd (< (cutscene-spool-index *cs-pup-anim*) 0))
            (let ((art (the-as art-joint-anim (lookup-art (-> pd draw art-group) *cs-pup-anim* art-joint-anim))))
              (pc-cutscene-puppet-status i (if art 2 1))
              (cutscene-puppet-say i (if art 2 1))
              (when art
                (let ((slot (cutscene-puppet-slot pd)))
                  (when (>= slot 0)
                    (set! (-> *cs-pup-art* slot) (the-as uint art))
                    ;; its frame: seconds at 60 a second times its speed; round again, or held on its last
                    (let ((last (the float (+ -1 (-> art data 0 length))))
                          (f (* (-> *cs-pup-out* 0) 60.0 (-> art speed))))
                      (set! (-> *cs-pup-frame* slot)
                            (cond
                              ((<= last 0.0) 0.0)
                              ((!= (-> *cs-pup-out* 1) 0.0) (- f (* (the float (the int (/ f last))) last)))
                              (else (fmin f last)))))
                    (set! (-> *cs-pup-seen* slot) 1)
                    (cutscene-puppet-apply slot pd)))))))
        (+! i 1))))
  ;; the ones let go: their own animation back
  (set! *cs-pup-count* 0)
  (dotimes (i 6)
    (when (nonzero? (-> *cs-pup-used* i))
      (cond
        ((nonzero? (-> *cs-pup-seen* i)) (+! *cs-pup-count* 1))
        (else
         (let ((pd (cutscene-puppet-proc i)))
           (when (and pd (nonzero? (-> pd skel)) (nonzero? (-> *cs-pup-saved* i)))
             (let ((ch (-> pd skel root-channel 0)))
               (set! (-> ch frame-group) (the-as art-joint-anim (-> *cs-pup-saved* i)))
               (set! (-> ch frame-num) 0.0)
               (set! (-> ch param 0) 0.0)
               (set! (-> ch num-func) num-func-identity))
             (if (zero? (-> *cs-pup-blerc* i)) (logclear! (-> pd skel status) (janim-status blerc)))))
         (set! (-> *cs-pup-used* i) 0)
         (set! (-> *cs-pup-applied* i) 0)
         (set! (-> *cs-pup-spool* i) 0)
         (format 0 "[cutscene] puppet slot ~D let go~%" i)))))
  ;; (none asked any more: said again next time)
  (when (not on)
    (dotimes (i 8) (set! (-> *cs-pup-said* i) 0)))
  (none))

;; the characters near the free camera, and their animations, for the editor's list
(defun cutscene-scan-actors ()
  (pc-cutscene-actors-begin)
  (iterate-process-tree
    *active-pool*
    (lambda ((p process-drawable))
      (when (and (type-type? (-> p type) process-drawable)
                 (not (type-type? (-> p type) sidekick))
                 (nonzero? (-> p skel))
                 (nonzero? (-> p draw))
                 (nonzero? (-> p root))
                 (< (vector-vector-distance (-> p root trans) *cs-pos*) (meters 40)))
        (let ((ag (-> p draw art-group))
              (nm (if (= p *target*) "jak" (the-as string (-> p name)))))
          (when (and ag (nonzero? ag) nm (= (-> nm type) string))
            (let ((fwd (vector-z-quaternion! (new 'stack-no-clear 'vector) (-> p root quat))))
              (set! (-> *cs-at* 0) (-> p root trans x))
              (set! (-> *cs-at* 1) (-> p root trans y))
              (set! (-> *cs-at* 2) (-> p root trans z))
              (set! (-> *cs-at* 3) (/ (atan (-> fwd x) (-> fwd z)) 182.04445)))
            (when (or (= p *target*) (name= (-> ag name) "fisher"))
              (dotimes (i (-> *cs-spools* length))
                (pc-cutscene-actor nm (-> *cs-spools* i))))
            (dotimes (i (-> ag length))
              (let ((a (-> ag data i)))
                (if (and a (nonzero? a) (type-type? (-> a type) art-joint-anim)) (pc-cutscene-actor nm (-> a name)))))
            ;; (after its name is in the list)
            (pc-cutscene-actor-at nm *cs-at*)
            (if (and (-> p draw mgeo) (nonzero? (-> p draw mgeo header blend-target-count)))
              (pc-cutscene-actor-face nm (the int (-> p draw mgeo header blend-target-count))))
            (when (and (nonzero? (-> p node-list)) (-> p node-list))
              (dotimes (j (-> p node-list length))
                (let ((jt (-> p node-list data j joint)))
                  (if (and (>= j 3) jt (nonzero? jt)) (pc-cutscene-actor-joint nm (-> jt name)))))))))
      (none))
    *null-kernel-context*)
  (none))

;; Jak Living Sky: the characters of a scene put where it says (its Places keys), facing the way it says,
;; every frame; put back where they were after (not Jak: he stays where the scene leaves him)
(define *cs-place-name* (new 'global 'string 64 (the-as string #f)))
(define *cs-place-out* (new 'static 'array float 4))
(define *cs-pl-used* (new 'static 'array int32 6))
(define *cs-pl-seen* (new 'static 'array int32 6))
(define *cs-pl-proc* (new 'static 'array handle 6))
(define *cs-pl-at* (new 'static 'inline-array vector 6))
(define *cs-pl-yaw* (new 'static 'array float 6))
(define *cs-pl-saved-trans* (new 'static 'inline-array vector 6))
(define *cs-pl-saved-quat* (new 'static 'inline-array vector 6))
(define *cs-pl-count* 0)

(defun cutscene-place-find ((name string))
  "a character or thing by its name (no skeleton needed, as for an animation)"
  (let ((proc (if (string= name "jak") *target* (process-by-name name *active-pool*))))
    (if (and proc
             (type-type? (-> proc type) process-drawable)
             (nonzero? (-> (the-as process-drawable proc) root))
             (nonzero? (-> (the-as process-drawable proc) draw)))
      (the-as process-drawable proc)
      (the-as process-drawable #f))))

(defun cutscene-place-proc ((i int))
  (the-as process-drawable (handle->process (-> *cs-pl-proc* i))))

(defun cutscene-place-put ((pd process-drawable) (pos vector) (yaw float))
  "there, facing that way (degrees)"
  (let ((root (-> pd root)))
    (when (nonzero? root)
      (if (type-type? (-> root type) collide-shape)
        (move-to-point! (the-as collide-shape root) pos)
        (set! (-> root trans quad) (-> pos quad)))
      (quaternion-axis-angle! (-> root quat) 0.0 1.0 0.0 (* yaw 182.04445))))
  (none))

(defun cutscene-place-slot ((pd process-drawable))
  "its slot, or a new one (where it was kept), -1 if all are taken"
  (let ((found -1))
    (dotimes (i 6)
      (if (and (< found 0) (nonzero? (-> *cs-pl-used* i)) (= (cutscene-place-proc i) pd)) (set! found i)))
    (when (< found 0)
      (dotimes (i 6)
        (when (and (< found 0) (zero? (-> *cs-pl-used* i)))
          (set! found i)
          (set! (-> *cs-pl-used* i) 1)
          (set! (-> *cs-pl-proc* i) (process->handle pd))
          (set! (-> *cs-pl-saved-trans* i quad) (-> pd root trans quad))
          (set! (-> *cs-pl-saved-quat* i quad) (-> pd root quat vec quad)))))
    found))

;; (also from ja-post's hook, so its own code can't move it after)
(defun cutscene-place-hook ((pd process-drawable))
  (when (nonzero? *cs-pl-count*)
    (dotimes (i 6)
      (when (and (nonzero? (-> *cs-pl-used* i)) (nonzero? (-> *cs-pl-seen* i)) (= (cutscene-place-proc i) pd))
        (cutscene-place-put pd (-> *cs-pl-at* i) (-> *cs-pl-yaw* i)))))
  (none))

(defun cutscene-places-update ((on symbol))
  (dotimes (i 6) (set! (-> *cs-pl-seen* i) 0))
  (when on
    (let ((i 0))
      (while (and (< i 8) (pc-cutscene-place i *cs-place-name* *cs-place-out*))
        (let ((pd (cutscene-place-find *cs-place-name*)))
          (when (and pd (nonzero? (-> pd root)))
            (let ((slot (cutscene-place-slot pd)))
              (when (>= slot 0)
                (set-vector! (-> *cs-pl-at* slot) (-> *cs-place-out* 0) (-> *cs-place-out* 1) (-> *cs-place-out* 2) 1.0)
                (set! (-> *cs-pl-yaw* slot) (-> *cs-place-out* 3))
                (set! (-> *cs-pl-seen* slot) 1)
                (cutscene-place-put pd (-> *cs-pl-at* slot) (-> *cs-pl-yaw* slot))))))
        (+! i 1))))
  ;; the ones let go: back where they were
  (set! *cs-pl-count* 0)
  (dotimes (i 6)
    (when (nonzero? (-> *cs-pl-used* i))
      (cond
        ((nonzero? (-> *cs-pl-seen* i)) (+! *cs-pl-count* 1))
        (else
         (let ((pd (cutscene-place-proc i)))
           (when (and pd (!= pd *target*) (nonzero? (-> pd root)))
             (if (type-type? (-> pd root type) collide-shape)
               (move-to-point! (the-as collide-shape (-> pd root)) (-> *cs-pl-saved-trans* i))
               (set! (-> pd root trans quad) (-> *cs-pl-saved-trans* i quad)))
             (set! (-> pd root quat vec quad) (-> *cs-pl-saved-quat* i quad))))
         (set! (-> *cs-pl-used* i) 0)))))
  (none))

;; Jak Living Sky: the editor's hand, as in Dreams: R2 held takes the character or thing nearest where the
;; free camera aims (5 m at most) and the camera stays still; the left stick moves it across the view (forward,
;; back, left, right; L1 held: up and down), the right stick turns it. Where it is goes to the editor as that
;; character's place at the cursor (a key there, made or moved)
(define *cs-grab* (new 'static 'array handle 1))
(define *cs-grab-on* #f)
(define *cs-grab-pos* (new 'static 'vector))
(define *cs-grab-yaw* 0.0)
(define *cs-grab-best* 0.0)
(define *cs-grab-aim* (new 'static 'vector))
(define *cs-grab-out* (new 'static 'array float 4))

(defun cutscene-name-of ((p process-drawable))
  "the name the editor knows it by (#f: none)"
  (cond
    ((= p *target*) "jak")
    ((and (-> p name) (= (-> (the-as basic (-> p name)) type) string)) (the-as string (-> p name)))
    (else (the-as string #f))))

;; the pad's cursor (moved by turning the controller: its gyroscope; Start held, back in the middle), and what
;; it's over: the body part, or the thing, nearest the line from the camera through it
(define *cs-cur* (new 'static 'array float 2))
(define *cs-pk-best* 0.0)
(define *cs-pk-proc* (new 'static 'array handle 1))
(define *cs-pk-j* 0)
(define *cs-pk-dir* (new 'static 'vector))

(defun cutscene-cursor-dir ((out vector))
  "the line from the camera through the cursor"
  (pc-cutscene-cursor *cs-cur*)
  (let ((right (new 'stack-no-clear 'vector))
        (up (new 'stack-no-clear 'vector)))
    (cutscene-forward out)
    (set-vector! right (- (cos *cs-yaw*)) 0.0 (sin *cs-yaw*) 1.0)
    (vector-cross! up right out)
    (vector-normalize! up 1.0)
    (vector+float*! out out right (* (-> *cs-cur* 0) (-> *math-camera* x-ratio)))
    (vector+float*! out out up (* (-> *cs-cur* 1) (-> *math-camera* y-ratio)))
    (vector-normalize! out 1.0))
  out)

(defun cutscene-ray-try ((p process-drawable) (pos vector) (j int))
  (let ((v (vector-! (new 'stack-no-clear 'vector) pos *cs-pos*)))
    (let ((along (vector-dot v *cs-pk-dir*)))
      (when (< (meters 0.3) along)
        ;; how far off the line, for how far away: an angle
        (vector+float*! v v *cs-pk-dir* (- along))
        (let ((a (/ (vector-length v) along)))
          (when (< a *cs-pk-best*)
            (set! *cs-pk-best* a)
            (set! (-> *cs-pk-proc* 0) (process->handle p))
            (set! *cs-pk-j* j))))))
  (none))

(defun cutscene-ray-pick ()
  "the character or thing under the cursor (and which body part, -1 its middle): #f none"
  (cutscene-cursor-dir *cs-pk-dir*)
  (set! *cs-pk-best* 0.12)
  (set! (-> *cs-pk-proc* 0) (the-as handle #f))
  (set! *cs-pk-j* -1)
  (iterate-process-tree
    *active-pool*
    (lambda ((p process-drawable))
      (when (and (type-type? (-> p type) process-drawable)
                 (not (type-type? (-> p type) sidekick))
                 (nonzero? (-> p root))
                 (nonzero? (-> p draw))
                 (cutscene-name-of p)
                 (< (vector-vector-distance (-> p root trans) *cs-pos*) (meters 60)))
        (cond
          ((and (nonzero? (-> p skel)) (nonzero? (-> p node-list)) (-> p node-list))
           (countdown (j (-> p node-list length))
             (if (>= j 3) (cutscene-ray-try p (-> p node-list data j bone transform vector 3) j))))
          (else (cutscene-ray-try p (-> p root trans) -1))))
      (none))
    *null-kernel-context*)
  (the-as process-drawable (handle->process (-> *cs-pk-proc* 0))))

(defun cutscene-grab-pick ()
  "the character or thing under the cursor"
  (let ((pd (cutscene-ray-pick)))
    (set! (-> *cs-grab* 0) (if pd (process->handle pd) (the-as handle #f)))
    (when pd
      (set! (-> *cs-grab-pos* quad) (-> pd root trans quad))
      (let ((fwd (vector-z-quaternion! (new 'stack-no-clear 'vector) (-> pd root quat))))
        (set! *cs-grab-yaw* (/ (atan (-> fwd x) (-> fwd z)) 182.04445)))
      (format 0 "[cutscene] took ~A~%" pd))
    pd))

;; Jak Living Sky: a character's body parts turned (round their own axes, in place) and moved (in their parent's
;; space) on top of their animation, as the scene says: each one a joint whose position the game works out
;; through our function (cspace param0, as the game's own look-at does), given back its own after
(define *cs-jt-used* (new 'static 'array int32 24))
(define *cs-jt-seen* (new 'static 'array int32 24))
(define *cs-jt-proc* (new 'static 'array handle 24))
(define *cs-jt-idx* (new 'static 'array int32 24))
(define *cs-jt-rot* (new 'static 'inline-array vector 24))
(define *cs-jt-off* (new 'static 'inline-array vector 24))
(define *cs-jt-q* (new 'static 'inline-array vector 24))
(define *cs-jt-p0* (new 'static 'array uint32 24))
(define *cs-jt-p1* (new 'static 'array uint32 24))
(define *cs-jt-p2* (new 'static 'array uint32 24))
(define *cs-pose-actor* (new 'global 'string 64 (the-as string #f)))
(define *cs-pose-joint* (new 'global 'string 64 (the-as string #f)))
(define *cs-pose-out* (new 'static 'array float 6))

(defun cutscene-joint-handler ((csp cspace) (xf transformq))
  (let ((i (the-as int (-> csp param1))))
    (when (and (>= i 0) (< i 24))
      (quaternion*! (-> xf quat) (-> xf quat) (the-as quaternion (-> *cs-jt-q* i)))
      (quaternion-normalize! (-> xf quat))
      (vector+! (-> xf trans) (-> xf trans) (-> *cs-jt-off* i))))
  (cspace<-parented-transformq-joint! csp xf)
  (none))

(defun cutscene-joint-index ((pd process-drawable) (name string))
  (let ((found -1))
    (when (and (nonzero? (-> pd node-list)) (-> pd node-list))
      (dotimes (j (-> pd node-list length))
        (let ((jt (-> pd node-list data j joint)))
          (if (and (< found 0) jt (nonzero? jt) (name= (-> jt name) name)) (set! found j)))))
    found))

(defun cutscene-joint-proc ((i int))
  (the-as process-drawable (handle->process (-> *cs-jt-proc* i))))

(defun cutscene-joint-slot ((pd process-drawable) (j int) (make symbol))
  "the slot of that body part, or a new one (make), -1 none"
  (let ((found -1))
    (dotimes (i 24)
      (if (and (< found 0) (nonzero? (-> *cs-jt-used* i)) (= (-> *cs-jt-idx* i) j) (= (cutscene-joint-proc i) pd))
        (set! found i)))
    (when (and make (< found 0))
      (dotimes (i 24)
        (when (and (< found 0) (zero? (-> *cs-jt-used* i)))
          (set! found i)
          (set! (-> *cs-jt-used* i) 1)
          (set! (-> *cs-jt-proc* i) (process->handle pd))
          (set! (-> *cs-jt-idx* i) j)
          (let ((csp (-> pd node-list data j)))
            (set! (-> *cs-jt-p0* i) (the-as uint (-> csp param0)))
            (set! (-> *cs-jt-p1* i) (the-as uint (-> csp param1)))
            (set! (-> *cs-jt-p2* i) (the-as uint (-> csp param2)))))))
    found))

(defun cutscene-joint-set ((i int) (pd process-drawable) (rot vector) (off vector))
  "the slot's turn (degrees) and move (game units), its joint through our function"
  (set! (-> *cs-jt-rot* i quad) (-> rot quad))
  (set-vector! (-> *cs-jt-off* i) (-> off x) (-> off y) (-> off z) 0.0)
  (let ((q (the-as quaternion (-> *cs-jt-q* i)))
        (qx (quaternion-axis-angle! (new 'stack-no-clear 'quaternion) 1.0 0.0 0.0 (* (-> rot x) 182.04445)))
        (qy (quaternion-axis-angle! (new 'stack-no-clear 'quaternion) 0.0 1.0 0.0 (* (-> rot y) 182.04445)))
        (qz (quaternion-axis-angle! (new 'stack-no-clear 'quaternion) 0.0 0.0 1.0 (* (-> rot z) 182.04445))))
    (quaternion*! q qy qx)
    (quaternion*! q q qz)
    (quaternion-normalize! q))
  (let ((csp (-> pd node-list data (-> *cs-jt-idx* i))))
    (set! (-> csp param0) cutscene-joint-handler)
    (set! (-> csp param1) (the-as basic i)))
  (none))

(defun cutscene-poses-update ((on symbol))
  (dotimes (i 24) (set! (-> *cs-jt-seen* i) 0))
  (when on
    (let ((i 0)
          (rot (new 'stack-no-clear 'vector))
          (off (new 'stack-no-clear 'vector)))
      (while (and (< i 32) (pc-cutscene-pose i *cs-pose-actor* *cs-pose-joint* *cs-pose-out*))
        (let ((pd (cutscene-puppet-find *cs-pose-actor*)))
          (when pd
            (let ((j (cutscene-joint-index pd *cs-pose-joint*)))
              (when (>= j 3)
                (let ((slot (cutscene-joint-slot pd j #t)))
                  (when (>= slot 0)
                    (set-vector! rot (-> *cs-pose-out* 0) (-> *cs-pose-out* 1) (-> *cs-pose-out* 2) 0.0)
                    (set-vector! off (-> *cs-pose-out* 3) (-> *cs-pose-out* 4) (-> *cs-pose-out* 5) 0.0)
                    (cutscene-joint-set slot pd rot off)
                    (set! (-> *cs-jt-seen* slot) 1)))))))
        (+! i 1))))
  ;; the ones let go: their own way back
  (dotimes (i 24)
    (when (and (nonzero? (-> *cs-jt-used* i)) (zero? (-> *cs-jt-seen* i)))
      (let ((pd (cutscene-joint-proc i)))
        (when (and pd (nonzero? (-> pd node-list)))
          (let ((csp (-> pd node-list data (-> *cs-jt-idx* i))))
            (set! (-> csp param0) (the-as function (-> *cs-jt-p0* i)))
            (set! (-> csp param1) (the-as basic (-> *cs-jt-p1* i)))
            (set! (-> csp param2) (the-as basic (-> *cs-jt-p2* i))))))
      (set! (-> *cs-jt-used* i) 0)))
  (none))

;; the pad on the body part picked in the editor: R2 held moves it (the left stick across the view; L1 held: up
;; and down), L2 held turns it in place (the left stick round its own y and x, the right stick round its z)
(define *cs-sel-actor* (new 'global 'string 64 (the-as string #f)))
(define *cs-sel-joint* (new 'global 'string 64 (the-as string #f)))
(define *cs-jg-rot* (new 'static 'vector))
(define *cs-jg-off* (new 'static 'vector))
(define *cs-jg-out* (new 'static 'array float 6))

(defun cutscene-pose-pad ()
  "#t while a picked body part is being turned or moved (the camera stays still)"
  (when (and (or (cpad-hold? 0 r2) (cpad-hold? 0 l2)) (pc-cutscene-pose-selected *cs-sel-actor* *cs-sel-joint*))
    (let* ((pd (cutscene-puppet-find *cs-sel-actor*))
           (j (if pd (cutscene-joint-index pd *cs-sel-joint*) -1)))
      ;; (the skeleton's own joints, from 3: 0-2 are the root's, worked out another way)
      (when (>= j 3)
        ;; from where it is now (its slot's), or none yet
        (when (or (cpad-pressed? 0 r2) (cpad-pressed? 0 l2))
          (let ((slot (cutscene-joint-slot pd j #f)))
            (cond
              ((>= slot 0)
               (set! (-> *cs-jg-rot* quad) (-> *cs-jt-rot* slot quad))
               (set! (-> *cs-jg-off* quad) (-> *cs-jt-off* slot quad)))
              (else
               (vector-reset! *cs-jg-rot*)
               (vector-reset! *cs-jg-off*)))))
        (let* ((pad (-> *cpad-list* cpads 0))
               (lx (cutscene-stick (the int (-> pad leftx))))
               (ly (- (cutscene-stick (the int (-> pad lefty)))))
               (rx (cutscene-stick (the int (-> pad rightx))))
               (dt (seconds-per-frame))
               (slow (cond
                       ((cpad-hold? 0 square) 0.25)
                       ((cpad-hold? 0 circle) 3.0)
                       (else 1.0))))
          (cond
            ((cpad-hold? 0 r2)
             ;; across the view, in its parent's space
             (let ((d (new 'stack-no-clear 'vector))
                   (speed (* (meters 0.5) dt slow))
                   (parent (-> pd node-list data j parent)))
               (set-vector! d (* lx speed (- (cos *cs-yaw*))) 0.0 (* lx speed (sin *cs-yaw*)) 0.0)
               (if (cpad-hold? 0 l1)
                 (+! (-> d y) (* ly speed))
                 (begin
                   (+! (-> d x) (* ly speed (sin *cs-yaw*)))
                   (+! (-> d z) (* ly speed (cos *cs-yaw*)))))
               (cond
                 ((and parent (nonzero? parent) (-> parent bone))
                  (let ((ax (new 'stack-no-clear 'vector)))
                    (vector-normalize-copy! ax (-> parent bone transform vector 0) 1.0)
                    (+! (-> *cs-jg-off* x) (vector-dot d ax))
                    (vector-normalize-copy! ax (-> parent bone transform vector 1) 1.0)
                    (+! (-> *cs-jg-off* y) (vector-dot d ax))
                    (vector-normalize-copy! ax (-> parent bone transform vector 2) 1.0)
                    (+! (-> *cs-jg-off* z) (vector-dot d ax))))
                 (else (vector+! *cs-jg-off* *cs-jg-off* d)))))
            (else
             ;; in place
             (+! (-> *cs-jg-rot* y) (* lx 90.0 dt slow))
             (+! (-> *cs-jg-rot* x) (* ly -90.0 dt slow))
             (+! (-> *cs-jg-rot* z) (* rx 90.0 dt slow))))
          (dotimes (c 3)
            (set! (-> *cs-jg-out* c) (-> *cs-jg-rot* data c))
            (set! (-> *cs-jg-out* (+ c 3)) (-> *cs-jg-off* data c)))
          (pc-cutscene-pose-grab *cs-sel-actor* *cs-sel-joint* *cs-jg-out*)))
      #t)))

;; X: the body part nearest the middle of the view picked (the nearest to the line the camera looks along, a
;; few degrees round it at most, any character near); X on nothing: none (R2 takes the whole character again)
(defun cutscene-joint-pick ()
  (let ((pd (cutscene-ray-pick)))
    (cond
      ((and pd (>= *cs-pk-j* 3))
       (let ((jt (-> pd node-list data *cs-pk-j* joint)))
         (format 0 "[cutscene] picked ~A ~S~%" pd (-> jt name))
         (pc-cutscene-pose-pick (cutscene-name-of pd) (-> jt name))))
      ;; (on nothing: the part picked stays picked; L1 + circle lets it go)
      (else #f)))
  (none))

;; (edit) a cross in the middle of the view, what X picks, the picked part's name
(define *cs-label* (new 'global 'string 160 (the-as string #f)))
(define *cs-label-up* (new 'global 'string 160 (the-as string #f)))

(defun cutscene-edit-marks ()
  (pc-cutscene-cursor *cs-cur*)
  (let ((font (new 'stack 'font-context *font-default-matrix*
                   (the int (* 256.0 (-> *cs-cur* 0)))
                   (the int (- 101.0 (* 112.0 (-> *cs-cur* 1))))
                   0.0 (font-color default) (font-flags shadow kerning))))
    (set! (-> font flags) (font-flags shadow kerning middle large))
    (set-width! font 512)
    (set-height! font 20)
    (print-game-text "+" font #f 128 22))
  (when (pc-cutscene-pose-selected *cs-sel-actor* *cs-sel-joint*)
    (format (clear *cs-label*) "~S: ~S" *cs-sel-actor* *cs-sel-joint*)
    (string-upcase *cs-label* *cs-label-up*)
    (let ((font (new 'stack 'font-context *font-default-matrix* 0 24 0.0 (font-color default) (font-flags shadow kerning))))
      (set! (-> font flags) (font-flags shadow kerning middle))
      (set-width! font 512)
      (set-height! font 20)
      (set-scale! font 0.6)
      (print-game-text *cs-label-up* font #f 128 22)))
  (none))

(defun cutscene-grab-update ()
  "R2 held: moving what it holds (#t: the camera is to stay still)"
  (when (and (cpad-pressed? 0 x) (cpad-hold? 0 l1) (not (cpad-hold? 0 r2)) (not (cpad-hold? 0 l2)))
    (cpad-clear! 0 x)
    (cutscene-joint-pick))
  ;; D-pad left: back a change (again and again), right: on again
  (when (cpad-pressed? 0 left)
    (cpad-clear! 0 left)
    (pc-cutscene-undo -1))
  (when (cpad-pressed? 0 right)
    (cpad-clear! 0 right)
    (pc-cutscene-undo 1))
  ;; L1 + circle: no body part picked any more (R2 and L2 take the whole character again)
  (when (and (cpad-pressed? 0 circle) (cpad-hold? 0 l1) (not (cpad-hold? 0 r2)) (not (cpad-hold? 0 l2)))
    (cpad-clear! 0 circle)
    (pc-cutscene-pose-pick "" ""))
  (cutscene-edit-marks)
  (cond
    ((cutscene-pose-pad) #t)
    ((not (or (cpad-hold? 0 r2) (cpad-hold? 0 l2)))
     (set! *cs-grab-on* #f)
     #f)
    (else
     (if (or (cpad-pressed? 0 r2) (cpad-pressed? 0 l2)) (set! *cs-grab-on* (the-as symbol (cutscene-grab-pick))))
     (let ((pd (the-as process-drawable (handle->process (-> *cs-grab* 0)))))
       (when (and *cs-grab-on* pd)
         (let* ((pad (-> *cpad-list* cpads 0))
                (lx (cutscene-stick (the int (-> pad leftx))))
                (ly (- (cutscene-stick (the int (-> pad lefty)))))
                (rx (cutscene-stick (the int (-> pad rightx))))
                (dt (seconds-per-frame))
                (speed (* (meters 3) dt (cond
                                          ((cpad-hold? 0 square) 0.25)
                                          ((cpad-hold? 0 circle) 3.0)
                                          (else 1.0))))
                (fwd (new 'stack-no-clear 'vector))
                (right (new 'stack-no-clear 'vector)))
           ;; the view's forward and right, flat
           (set-vector! fwd (sin *cs-yaw*) 0.0 (cos *cs-yaw*) 1.0)
           (set-vector! right (- (cos *cs-yaw*)) 0.0 (sin *cs-yaw*) 1.0)
           (cond
             ((cpad-hold? 0 r2)
              (vector+float*! *cs-grab-pos* *cs-grab-pos* right (* lx speed))
              (if (cpad-hold? 0 l1)
                (+! (-> *cs-grab-pos* y) (* ly speed))
                (vector+float*! *cs-grab-pos* *cs-grab-pos* fwd (* ly speed)))
              (set! *cs-grab-yaw* (- *cs-grab-yaw* (* rx 120.0 dt))))
             (else
              ;; L2: turned where it stands
              (set! *cs-grab-yaw* (- *cs-grab-yaw* (* (+ lx rx) 120.0 dt)))))
           (cutscene-place-put pd *cs-grab-pos* *cs-grab-yaw*)
           (set! (-> *cs-grab-out* 0) (-> *cs-grab-pos* x))
           (set! (-> *cs-grab-out* 1) (-> *cs-grab-pos* y))
           (set! (-> *cs-grab-out* 2) (-> *cs-grab-pos* z))
           (set! (-> *cs-grab-out* 3) *cs-grab-yaw*)
           (pc-cutscene-grab (cutscene-name-of pd) *cs-grab-out*)))
       #t))))

;; Jak Living Sky: a character's face shapes by hand (the mouth opened, ...), as the scene says: each shape's
;; weight (-1..1) added on top of its animation's, through merc-blend-shape's hook; its blend shapes on meanwhile
(define *cs-fc-used* (new 'static 'array int32 6))
(define *cs-fc-seen* (new 'static 'array int32 6))
(define *cs-fc-proc* (new 'static 'array handle 6))
(define *cs-fc-w* (new 'static 'array float 96))
(define *cs-fc-blerc* (new 'static 'array int32 6))
(define *cs-fc-count* 0)
(define *cs-face-name* (new 'global 'string 64 (the-as string #f)))
(define *cs-face-out* (new 'static 'array float 16))

(defun cutscene-face-proc ((i int))
  (the-as process-drawable (handle->process (-> *cs-fc-proc* i))))

(defun cutscene-face-hook ((pd process-drawable) (buf (pointer int16)) (n int))
  (let ((found #f))
    (when (nonzero? *cs-fc-count*)
      (dotimes (i 6)
        (when (and (nonzero? (-> *cs-fc-used* i)) (nonzero? (-> *cs-fc-seen* i)) (= (cutscene-face-proc i) pd))
          (set! found #t)
          (dotimes (k (min n 16))
            (set! (-> buf k)
                  (the int (fmax -32000.0 (fmin 32000.0 (+ (the float (-> buf k)) (* 4096.0 (-> *cs-fc-w* (+ (* i 16) k))))))))))))
    found))

(defun cutscene-face-hook-pc ((pd process-drawable) (out (pointer float)) (n int))
  "(the PC's face weights: 4032 is all of a shape)"
  (let ((found #f))
    (when (nonzero? *cs-fc-count*)
      (dotimes (i 6)
        (when (and (nonzero? (-> *cs-fc-used* i)) (nonzero? (-> *cs-fc-seen* i)) (= (cutscene-face-proc i) pd))
          (set! found #t)
          (dotimes (k (min n 16))
            (+! (-> out k) (* 4032.0 (-> *cs-fc-w* (+ (* i 16) k))))))))
    found))

(defun cutscene-faces-update ((on symbol))
  (set! *blerc-hook* cutscene-face-hook)
  (set! *blerc-hook-pc* cutscene-face-hook-pc)
  (dotimes (i 6) (set! (-> *cs-fc-seen* i) 0))
  (when on
    (let ((i 0))
      (while (and (< i 8) (pc-cutscene-face i *cs-face-name* *cs-face-out*))
        (let ((pd (cutscene-puppet-find *cs-face-name*)))
          (when pd
            (let ((slot -1))
              (dotimes (s 6)
                (if (and (< slot 0) (nonzero? (-> *cs-fc-used* s)) (= (cutscene-face-proc s) pd)) (set! slot s)))
              (when (< slot 0)
                (dotimes (s 6)
                  (when (and (< slot 0) (zero? (-> *cs-fc-used* s)))
                    (set! slot s)
                    (set! (-> *cs-fc-used* s) 1)
                    (set! (-> *cs-fc-proc* s) (process->handle pd))
                    (set! (-> *cs-fc-blerc* s) (if (logtest? (-> pd skel status) (janim-status blerc)) 1 0)))))
              (when (>= slot 0)
                (dotimes (k 16) (set! (-> *cs-fc-w* (+ (* slot 16) k)) (-> *cs-face-out* k)))
                (set! (-> *cs-fc-seen* slot) 1)
                (logior! (-> pd skel status) (janim-status blerc))))))
        (+! i 1))))
  (set! *cs-fc-count* 0)
  (dotimes (i 6)
    (when (nonzero? (-> *cs-fc-used* i))
      (cond
        ((nonzero? (-> *cs-fc-seen* i)) (+! *cs-fc-count* 1))
        (else
         (let ((pd (cutscene-face-proc i)))
           (if (and pd (zero? (-> *cs-fc-blerc* i))) (logclear! (-> pd skel status) (janim-status blerc))))
         (set! (-> *cs-fc-used* i) 0)))))
  (none))

;; the pad to the timeline bar (Triangle takes it there and back): #t while it has it
(define *cs-sticks* (new 'static 'array float 3))
(defun cutscene-timeline-pad ()
  (let ((pad (-> *cpad-list* cpads 0)))
    (set! (-> *cs-sticks* 0) (cutscene-stick (the int (-> pad leftx))))
    (set! (-> *cs-sticks* 1) (- (cutscene-stick (the int (-> pad lefty)))))
    (set! (-> *cs-sticks* 2) (cutscene-stick (the int (-> pad rightx))))
    (pc-cutscene-timeline-pad (the int (-> pad button0-rel 0)) (the int (-> pad button0-abs 0)) *cs-sticks*)))

;; (a capture) each character near the camera's skeleton: its joints, their parents, where they are
(defun cutscene-dump-skeletons ()
  (iterate-process-tree
    *active-pool*
    (lambda ((p process-drawable))
      (when (and (type-type? (-> p type) process-drawable)
                 (not (type-type? (-> p type) sidekick))
                 (nonzero? (-> p skel))
                 (nonzero? (-> p node-list))
                 (-> p node-list)
                 (cutscene-name-of p)
                 (< (vector-vector-distance (-> p root trans) *cs-pos*) (meters 40)))
        (let ((nl (-> p node-list)))
          (dotimes (j (-> nl length))
            (let* ((csp (-> nl data j))
                   (jt (-> csp joint))
                   (parent -1))
              (dotimes (k (-> nl length))
                (if (= (-> nl data k) (-> csp parent)) (set! parent k)))
              (when (and (-> csp bone) (nonzero? (-> csp bone)) jt (nonzero? jt))
                (pc-cutscene-joint-dump (cutscene-name-of p) (+ j (* 65536 (+ parent 1))) (-> jt name)
                                        (the-as (pointer float) (-> csp bone transform))))))))
      (none))
    *null-kernel-context*)
  (none))

(defun cutscene-update ()
  (when (and *target* *camera*)
    (let ((mode (pc-cutscene-poll *cs-out* *cs-speaker* *cs-text* 512)))
      (cutscene-puppets-update (nonzero? mode))
      (cutscene-places-update (nonzero? mode))
      (cutscene-poses-update (nonzero? mode))
      (cutscene-faces-update (nonzero? mode))
      (if (and (= mode 2) (!= (-> *cs-out* 10) 0.0)) (cutscene-scan-actors))
      (if (and (= mode 2) (!= (-> *cs-out* 11) 0.0)) (cutscene-dump-skeletons))
      (cond
        ((zero? mode)
         (when (nonzero? *cs-mode*)
           (send-event *camera* 'change-state *camera-base-mode* 0)
           (if *cs-held* (send-event *target* 'end-mode))
           (set! *cs-held* #f)))
        (else
         (when (zero? *cs-mode*)
           (send-event *camera* 'change-state cam-fixed 0)
           ;; (where the game's camera was, to start from)
           (set! (-> *cs-pos* quad) (-> (math-camera-pos) quad))
           (vector+float*! *cs-look* *cs-pos* (-> *math-camera* inv-camera-rot vector 2) (meters 10))
           (cutscene-aim-from-look))
         (when (and (not *cs-held*) (or (= mode 2) (!= (-> *cs-out* 8) 0.0)))
           (send-event *target* 'change-mode 'grab)
           (set! *cs-held* #t))
         (cond
           ((= mode 2)
            (when (!= (-> *cs-out* 6) 0.0)
              (set-vector! *cs-pos* (-> *cs-out* 0) (-> *cs-out* 1) (-> *cs-out* 2) 1.0)
              (set-vector! *cs-look* (-> *cs-out* 3) (-> *cs-out* 4) (-> *cs-out* 5) 1.0)
              (cutscene-aim-from-look))
            (if (not (cutscene-timeline-pad)) (cutscene-free-camera))
            (set! (-> *cs-out* 0) (-> *cs-pos* x))
            (set! (-> *cs-out* 1) (-> *cs-pos* y))
            (set! (-> *cs-out* 2) (-> *cs-pos* z))
            (set! (-> *cs-out* 3) (-> *cs-look* x))
            (set! (-> *cs-out* 4) (-> *cs-look* y))
            (set! (-> *cs-out* 5) (-> *cs-look* z))
            (let ((aim (cutscene-aim-point (new 'stack-no-clear 'vector))))
              (set! (-> *cs-out* 6) (-> aim x))
              (set! (-> *cs-out* 7) (-> aim y))
              (set! (-> *cs-out* 8) (-> aim z)))
            (pc-cutscene-report *cs-out*))
           ((!= (-> *cs-out* 9) 0.0)
            (set-vector! *cs-pos* (-> *cs-out* 0) (-> *cs-out* 1) (-> *cs-out* 2) 1.0)
            (set-vector! *cs-look* (-> *cs-out* 3) (-> *cs-out* 4) (-> *cs-out* 5) 1.0)))
         (cutscene-camera-apply)
         (if (!= (-> *cs-out* 7) 0.0) (set-letterbox-frames (seconds 0.1)))
         (hide-hud)
         (if (nonzero? (length *cs-text*)) (cutscene-subtitle *cs-speaker* *cs-text*))
         (when (and (= mode 1) (cpad-pressed? 0 triangle))
           (cpad-clear! 0 triangle)
           (pc-cutscene-stop))))
      (set! *cs-mode* mode)))
  (none))

;; Jak Living Sky: lines said by Daxter, the fisherman..., one after the other (never over each other). Timed
;; by the computer's own clock (300 ticks a second, as time-frames): the game's clocks step by whole frames and
;; drift from it below 60 fps, the subtitles running ahead of the voice and the next line over the last. Until
;; when someone's talking:
(define *daxter-talk-until* (the-as time-frame 0))

;; (the EE timer, 300,000,000 a second, wraps at 32 bits, every 14 s: its steps are added up instead, called every
;; frame (soul-pile-update). Kept in an array: a global symbol holds 32 bits. 0: the timer last seen, 1: what's
;; left over under a tick, 2: the ticks)
(define *quest-clock* (new 'static 'array int64 3))

(defun quest-now ()
  "now, by the computer's clock, in time-frame ticks (300 a second)"
  (let* ((raw (logand (the-as int (__read-ee-timer)) #xffffffff))
         (step (logand (- raw (-> *quest-clock* 0)) #xffffffff)))
    (set! (-> *quest-clock* 0) raw)
    ;; (a step longer than 10 s: the first, or the game held up: not counted)
    (when (< step 3000000000)
      (+! (-> *quest-clock* 1) step)
      (let ((ticks (/ (-> *quest-clock* 1) 1000000)))
        (+! (-> *quest-clock* 2) ticks)
        (-! (-> *quest-clock* 1) (* ticks 1000000)))))
  (the-as time-frame (-> *quest-clock* 2)))

;; (the game decodes a whole mp3 before it plays it: the longer, the later it starts)
(defun quest-line-latency ((len time-frame))
  (the-as time-frame (+ (seconds 0.3) (/ (the int len) 64))))

;; (lines given up, all those queued: a scene skipped. Each line keeps the count it was queued under)
(define *quest-gen* 0)

(defun quest-lines-cancel ()
  (+! *quest-gen* 1)
  (set! *daxter-talk-until* (quest-now))
  (none))

;; a line someone says (file: custom_assets/jak1/audio/voice/..., parts: subtitle text id, ticks (300 a
;; second), text id, ticks...: each part for its own time), after any other still going: its turn fixed now, in
;; the order asked for. Returns when its voice will start (quest-now's time)
(defun quest-line2 ((speaker string) (file string) (parts (array int32)))
  (let ((total 0))
    (dotimes (i (/ (-> parts length) 2))
      (+! total (-> parts (+ (* 2 i) 1))))
    (let* ((start-at (max (quest-now) *daxter-talk-until*))
           (late (quest-line-latency (the-as time-frame total))))
      (set! *daxter-talk-until* (+ start-at late total (seconds 0.6)))
      (process-spawn-function
        process
        (lambda :behavior process ((speaker string) (file string) (parts (array int32)) (start-at time-frame)
                                   (late time-frame) (gen int))
          (while (< (quest-now) start-at)
            (if (!= gen *quest-gen*) (deactivate self))
            (suspend))
          (play-sound-file file 200)
          (let ((start (+ (quest-now) late))
                (total 0))
            (dotimes (i (/ (-> parts length) 2))
              (+! total (-> parts (+ (* 2 i) 1))))
            (while (< (quest-now) (+ start total))
              (when (!= gen *quest-gen*)
                (stop-sound-file file)
                (deactivate self))
              (let ((at (- (quest-now) start))
                    (k 0))
                (while (and (< (+ k 2) (-> parts length)) (>= at (-> parts (+ k 1))))
                  (set! at (- at (-> parts (+ k 1))))
                  (+! k 2))
                (if (>= at 0) (brume-radio-subtitle speaker (-> parts k))))
              (suspend)))
          (none))
        speaker file parts start-at late *quest-gen*
        :to *entity-pool*)
      (the-as time-frame (+ start-at late)))))

;; (one subtitle for all of it)
(defun quest-line ((speaker string) (file string) (text int) (len time-frame))
  (let ((parts (new 'global 'boxed-array int32 2)))
    (set! (-> parts 0) text)
    (set! (-> parts 1) (the int len))
    (quest-line2 speaker file parts))
  (none))

(defun daxter-dark-line ((file string) (text int) (len time-frame))
  (quest-line "DAXTER" file text len)
  (none))

;; the first time a corrupted enemy is near (nav-enemy.gc): "Jak, look at that one! Its eyes are purple..."
;; (custom_assets/jak1/audio/voice/daxter-dark-enemy.mp3, 5.7 s)
(defun daxter-dark-enemy-line ()
  (set! *daxter-dark-seen* 1.0)
  (daxter-dark-line "voice/daxter-dark-enemy.mp3" #x464e (seconds 5.9))
  (none))

;; the first time Jak takes in dark eco (collectables.gc): "Jak, stop! That's dark eco! You don't want to turn
;; into an ottsel too?" (daxter-dark-eco.mp3, 5.1 s)
(defun daxter-dark-eco-line ()
  (set! *daxter-dark-eco-seen* 1.0)
  (daxter-dark-line "voice/daxter-dark-eco.mp3" #x464f (seconds 5.3))
  (none))

;; the first time Jak turns into Dark Jak (target2.gc), once the turning's roar is over: "Jak? Are... are you
;; still in there? Give me a sign..." (daxter-dark-jak.mp3, 5.9 s)
(defun daxter-dark-jak-line ()
  (set! *daxter-dark-jak-seen* 1.0)
  (set! *daxter-talk-until* (max *daxter-talk-until* (+ (quest-now) (seconds 2))))
  (daxter-dark-line "voice/daxter-dark-jak.mp3" #x4650 (seconds 6.1))
  (none))

;; Jak turning back from Dark Jak (his time over, or another eco taken; not dying). The first time: "Maybe we'd
;; better not tell Samos what happened to you." (daxter-dark-jak-end.mp3, 3.9 s); the second: "Oh, so dark eco
;; gives you horns and superpowers, and me orange fur? That's not fair!" (daxter-dark-jak-end2.mp3, 6 s)
(defun dark-jak-end-line ()
  (when (and (< *daxter-dark-jak-end-seen* 2.0) *target*
             (not (logtest? (-> *target* state-flags) (state-flags dying))))
    (if (zero? *daxter-dark-jak-end-seen*)
      (daxter-dark-line "voice/daxter-dark-jak-end.mp3" #x4651 (seconds 4.1))
      (daxter-dark-line "voice/daxter-dark-jak-end2.mp3" #x4652 (seconds 6.2)))
    (set! *daxter-dark-jak-end-seen* (+ *daxter-dark-jak-end-seen* 1.0)))
  (none))

;; kept off the radio's stack (a spawned process's stack is saved in 256 bytes when it suspends)
(define *brume-cam-gate* (new 'global 'vector))
(define *brume-cam-pos* (new 'global 'vector))
(define *brume-cam-dir* (new 'global 'vector))

(defun brume-radio-play ()
  (process-spawn-function
    process
    (lambda :behavior process ()
      (voicebox-spawn self (target-pos 0))
      (play-sound-file "voice/keira-brume.mp3" 100)
      (let ((start (current-time))
            (gate (brume-warp-gate-pos *brume-cam-gate*))
            (looking #f)
            (pos *brume-cam-pos*))
        ;; Keira: 11 s; from the 5th, where she speaks of the signal, the camera holds still and looks at
        ;; the warp gate
        (while (not (time-elapsed? start (seconds 11.2)))
          (when (and gate (time-elapsed? start (seconds 5)) (> (-> *camera* num-slaves) 0))
            ;; closer: from where the camera is, toward the gate, until 8 m from it; Jak held still meanwhile
            (when (not looking)
              (set! looking #t)
              (let ((from (-> *camera* slave 0 0 trans)))
                (vector-lerp! pos gate from (fmin 1.0 (/ (meters 8) (vector-vector-distance gate from)))))
              (send-event *target* 'change-mode 'grab)
              (send-event *camera* 'change-state cam-fixed 0))
            (dotimes (i (-> *camera* num-slaves))
              (let ((cam (-> *camera* slave i 0))
                    (dir *brume-cam-dir*))
                (set! (-> cam saved-pt quad) (-> pos quad))
                (set! (-> cam trans quad) (-> pos quad))
                (vector-! dir gate pos)
                (vector-normalize! dir 1.0)
                (forward-down->inv-matrix (-> cam tracking inv-mat) dir (-> *camera* local-down)))))
          (brume-radio-subtitle "KEIRA" #x4649)
          (suspend))
        (when looking
          (send-event *camera* 'change-state *camera-base-mode* 0)
          (send-event *target* 'end-mode))
        ;; Daxter: 7 s
        (play-sound-file "voice/daxter-brume.mp3" 200)
        (set! start (current-time))
        (while (not (time-elapsed? start (seconds 7.4)))
          (brume-radio-subtitle "DAXTER" #x464a)
          (suspend)))
      (none))
    :to *entity-pool*)
  (none))

;; Jak Living Sky: near the levitator without the cells, once Keira has said it takes 60: her line
;; with 60, not the game's with 45 (custom_assets/jak1/audio/voice/keira-levitator-60.mp3). Not again
;; for 30 s
(define *brume-lev-hint-last* -100000)

(defun brume-levitator-hint ()
  (let ((now (the int (/ (the float (current-time)) 300.0))))
    (when (or (< now *brume-lev-hint-last*) (>= (- now *brume-lev-hint-last*) 30))
      (set! *brume-lev-hint-last* now)
      (process-spawn-function
        process
        (lambda :behavior process ()
          (voicebox-spawn self (target-pos 0))
          (play-sound-file "voice/keira-levitator-60.mp3" 100)
          (let ((start (current-time)))
            (while (not (time-elapsed? start (seconds 4.5)))
              (brume-radio-subtitle "KEIRA" #x464b)
              (suspend)))
          (none))
        :to *entity-pool*)))
  (none))
