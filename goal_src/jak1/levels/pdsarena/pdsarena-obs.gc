;;-*-Lisp-*-
(in-package goal)

;; Jak Living Sky: what the PDS sentinel's code (The Forgotten Lands, by Kuitar5, with permission) takes from the
;; rest of that mod: its small helper macros and constants, brought here so the engine stays as it is.

(defmacro set-part! (&key (proc self) &key (id 1) &key (part part))
  `(set! (-> ,proc ,part) (create-launch-control (-> *part-group-id-table* ,id) ,proc)))

(defmacro hide! (proc)
  `(logior! (-> ,proc draw status) (draw-status hidden)))

(defmacro show! (proc)
  `(logclear! (-> ,proc draw status) (draw-status hidden)))

(defmacro get-init-spec-by-id (part id)
  `(let ((i 0)
         (spec (the sp-field-init-spec #f)))
     (while (!= (-> *part-id-table* ,part init-specs i field) (sp-field-id spt-end))
       (let ((init-spec (-> *part-id-table* ,part init-specs i)))
         (if (= (-> init-spec field) (sp-field-id ,(string->symbol-format "spt-{}" (symbol->string id)))) (set! spec init-spec)))
       (1+! i))
     spec))

(defmacro relocate-fields (&rest fields)
  `(begin
     ,@(apply (lambda (x) `(if (nonzero? (-> this ,x)) (&+! (-> this ,x) offset))) fields)))

(defmacro defpost (type &rest body)
  "a type's post behavior, <type>-post"
  `(defbehavior ,(string->symbol-format "{}-post" (symbol->string type)) ,type () ,@body))

(defmacro defevent (type &rest body)
  "a type's event handler, <type>-event-handler"
  `(defbehavior ,(string->symbol-format "{}-event-handler" (symbol->string type))
                ,type ((proc process) (argc int) (message symbol) (block event-message-block)) ,@body))

(defmacro true? (thing)
  `(eq? ,thing #t))

(defmacro static-exploder-params (name &key (jgeo #f) joints)
  `(define ,(string->symbol-format "*{}-exploder-params*" name)
    (new 'static
         'joint-exploder-static-params
         :joints
         (new 'static
              'boxed-array
              :type
              joint-exploder-static-joint-params
              ,@(apply (lambda (x)
                       `(new 'static
                            'joint-exploder-static-joint-params
                            :joint-index
                            (joint-node-index ,(if jgeo (string->symbol-format "{}-lod0-jg" jgeo) (string->symbol-format "{}-lod0-jg" name))
                                              ,(if (pair? x) (car x) x))
                            :parent-joint-index
                            ,(if (pair? x) (joint-node-index (cadr x)) -1)))
                     joints)))))

(defglobalconstant DEFAULT_RES_TIME -1000000000.0)

(defconstant DEFAULT_PATH_FLAGS (path-control-flag display draw-line draw-point draw-text))

;; the fight's music, as The Forgotten Lands plays it (its tfl-music-player, by Kuitar5): its
;; custom_assets/jak1/audio/tfl/music/pds-sentinel.mp3 looping from the sentinel's waking ('boss 'pds-sentinel) to its
;; end ('boss #f), Misty's own music silent the while, paused with the game; a child of the fight's master (gone with
;; the level: the music stops). The sentinel asks by pds-music-boss, a global: it wakes as the fight's level comes in,
;; maybe before the master (and its player) is born, and a message to a player not there yet was lost
(define *tfl-music-player* (the-as process #f))
(define *pds-music-want* (the-as symbol #f))  ;; (#f again each time the level's linked)
(define-extern *main-music-busy* symbol)
(define-extern *last-music-level* symbol)

(defun pds-music-boss ((music symbol))
  (format 0 "[music] boss ~A (player ~A)~%" music *tfl-music-player*)
  (set! *pds-music-want* music)
  (none))

(deftype pds-music (process)
  ((playing symbol)
   (paused  symbol))
  (:state-methods
   active))

(defmethod deactivate ((this pds-music))
  (when (-> this playing)
    (stop-main-music)
    (set! *main-music-busy* #f)
    (set! *last-music-level* #f))
  (set! *pds-music-want* #f)
  (set! *tfl-music-player* (the-as process #f))
  (call-parent-method this)
  (none))

(defstate active (pds-music)
  :virtual #t
  :code
    (behavior ()
      (loop
        (cond
          ((and *pds-music-want* (not (-> self playing)))
           (set! *main-music-busy* #t)
           (format 0 "[music] play pds-sentinel.mp3 at ~D~%" (the int (-> *setting-control* default music-volume)))
           (play-main-music "tfl/music/pds-sentinel.mp3" (the int (-> *setting-control* default music-volume)))
           (set-setting! 'music-volume 'abs 0.0 0)
           (set! (-> self playing) #t)
           (set! (-> self paused) #f))
          ((and (not *pds-music-want*) (-> self playing))
           (format 0 "[music] stop~%")
           (stop-main-music)
           (remove-setting! 'music-volume)
           (set! *main-music-busy* #f)
           (set! *last-music-level* #f)
           (set! (-> self playing) #f)))
        (when (-> self playing)
          (let ((p (if (paused?) #t #f)))
            (when (!= p (-> self paused))
              (if p (pause-main-music) (resume-main-music))
              (set! (-> self paused) p))))
        (suspend))))

(defbehavior pds-music-init-by-other pds-music ()
  (process-mask-clear! (-> self mask) pause menu)
  (set! (-> self playing) #f)
  (set! (-> self paused) #f)
  (set! *tfl-music-player* self)
  (format 0 "[music] player born, want ~A~%" *pds-music-want*)
  (go-virtual active))

(defun pds-reset-part ()
  (set! (-> (get-init-spec-by-id 4133 scale-x) initial-valuef) (meters 4.0))
  (set! (-> (get-init-spec-by-id 4133 scale-x) random-rangef) (meters 3.5))
  (set! (-> (get-init-spec-by-id 4133 r) initial-valuef) 64.0)
  (set! (-> (get-init-spec-by-id 4133 g) initial-valuef) 256.0)
  (set! (-> (get-init-spec-by-id 4133 b) initial-valuef) 64.0)
  (set! (-> (get-init-spec-by-id 4133 num) initial-valuef) 0.6)
  (set! (-> (get-init-spec-by-id 4170 num) initial-valuef) 0.2))

;; the merchant's third fight won (*arena-won* bit 2: the JET-Board on sale), saved at once
(defun pds-arena-won ()
  (set! *arena-won* (the float (logior (the int *arena-won*) 4)))
  (auto-save-command 'auto-save 0 0 *default-pool*)
  (none))

;; (the mod's kernel helper) a handle's process, if still there, stopped
(defun deactivate-handle ((h handle))
  (let ((p (handle->process h)))
    (if p (deactivate p)))
  (none))

;; the fight's enemies (Misty's babak and bonelurker) standing on its floor: their nav info's ground probe on the
;; traps too while the fight's on (on: an enemy's born; off: the master's gone, the level unloading)
(define-extern *bonelurker-nav-enemy-info* nav-enemy-info)
(defun pds-arena-ground ((on symbol))
  (dolist (sym '(*babak-nav-enemy-info* *bonelurker-nav-enemy-info*))
    (let ((info (the-as nav-enemy-info (-> (the-as symbol (car sym)) value))))
      (when (and info (nonzero? info))
        (if on
          (logior! (-> info gnd-collide-with) (collide-kind cak-1 ground-object))
          (logclear! (-> info gnd-collide-with) (collide-kind cak-1 ground-object))))))
  (none))
