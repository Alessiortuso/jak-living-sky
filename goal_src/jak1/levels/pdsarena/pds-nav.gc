;;-*-Lisp-*-
(in-package goal)

;; Jak Living Sky: the PDS sentinel fight's nav mesh (The Forgotten Lands, by Kuitar5, with permission): the mod's
;; arena hexagon (*nav-valley-boss*), moved onto Misty's arena floor and turned 52 degrees like the level's actors
;; (scripts/enhanced/build_pdsarena.py). Hooked to the master's 'custom-nav lump in entity.gc.

(set! *pds-arena-nav*
  (new 'static
       'nav-mesh
       :custom-hacky? #t
       :bounds
       (new 'static 'sphere :x (meters -197.28) :y (meters 28.0) :z (meters 958.28) :w (meters 64.26))
       :origin
       (new 'static 'vector :x (meters -197.28) :y (meters 28.0) :z (meters 958.28) :w 1.0000)
       :vertex-count 6
       :vertex
       (new 'static
            'inline-array
            nav-vertex
            6
            (new 'static 'nav-vertex :x (meters -48.1041) :y (meters 0.0) :z (meters -6.7606) :w 1.0000)
            (new 'static 'nav-vertex :x (meters -29.9069) :y (meters 0.0) :z (meters 38.2791) :w 1.0000)
            (new 'static 'nav-vertex :x (meters 18.1972) :y (meters 0.0) :z (meters 45.0397) :w 1.0000)
            (new 'static 'nav-vertex :x (meters 48.1041) :y (meters 0.0) :z (meters 6.7606) :w 1.0000)
            (new 'static 'nav-vertex :x (meters 29.9069) :y (meters 0.0) :z (meters -38.2791) :w 1.0000)
            (new 'static 'nav-vertex :x (meters -18.1972) :y (meters 0.0) :z (meters -45.0397) :w 1.0000))
       :poly-count 4
       :poly
       (new 'static
            'inline-array
            nav-poly
            4
            (new 'static 'nav-poly :id #x0 :vertex (new 'static 'array uint8 3 #x2 #x4 #x5) :adj-poly (new 'static 'array uint8 3 #x3 #xff #x1) :pat 0)
            (new 'static 'nav-poly :id #x1 :vertex (new 'static 'array uint8 3 #x2 #x5 #x0) :adj-poly (new 'static 'array uint8 3 #x0 #xff #x2) :pat 0)
            (new 'static 'nav-poly :id #x2 :vertex (new 'static 'array uint8 3 #x0 #x1 #x2) :adj-poly (new 'static 'array uint8 3 #xff #xff #x1) :pat 0)
            (new 'static 'nav-poly :id #x3 :vertex (new 'static 'array uint8 3 #x2 #x3 #x4) :adj-poly (new 'static 'array uint8 3 #xff #xff #x0) :pat 0))
       :route
       (new 'static 'inline-array vector4ub 2 (new 'static 'vector4ub :data (new 'static 'array uint8 4 #xef #x3f #xbe #xeb)))))
